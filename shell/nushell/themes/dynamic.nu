# dynamic.nu — generated by apply-theme from tokyo-night.nu. Do not edit.
# Tokyo Night color theme for Nushell
# Palette: https://github.com/enkia/tokyo-night-vscode-theme
export def main [] {
    return {
        binary: '#ff2a3d'
        block: '#c4303f'
        cell-path: '#e6dcdc'
        closure: '#ff7a7a'
        custom: '#e6dcdc'
        duration: '#e8a04c'
        float: '#e8a04c'
        glob: '#e6dcdc'
        int: '#ff2a3d'
        list: '#ff7a7a'
        nothing: '#ff5566'
        range: '#e8a04c'
        record: '#c4303f'
        string: '#8aa37b'

        bool: {|| if $in { '#8aa37b' } else { '#ff5566' } }

        datetime: {|| (date now) - $in |
            if $in < 1hr {
                { fg: '#ff5566' attr: 'b' }
            } else if $in < 6hr {
                '#e8a04c'
            } else if $in < 1day {
                '#e8a04c'
            } else if $in < 3day {
                '#8aa37b'
            } else if $in < 1wk {
                { fg: '#ff7a7a' attr: 'b' }
            } else if $in < 6wk {
                '#c4303f'
            } else if $in < 52wk {
                '#ff2a3d'
            } else { 'dark_gray' }
        }

        filesize: {|e|
            if $e == 0b {
                '#7a5256'
            } else if $e < 1mb {
                '#ff7a7a'
            } else {{ fg: '#c4303f' attr: 'b' }}
        }

        shape_and: { fg: '#ff2a3d' attr: 'b' }
        shape_binary: { fg: '#ff2a3d' attr: 'b' }
        shape_block: { fg: '#c4303f' attr: 'b' }
        shape_bool: '#8aa37b'
        shape_closure: { fg: '#ff7a7a' attr: 'b' }
        shape_custom: '#e6dcdc'
        shape_datetime: { fg: '#ff7a7a' attr: 'b' }
        shape_directory: '#c4303f'
        shape_external: '#e6dcdc'
        shape_external_resolved: '#8aa37b'
        shape_externalarg: { fg: '#e6dcdc' attr: 'b' }
        shape_filepath: '#c4303f'
        shape_flag: { fg: '#ff2a3d' attr: 'b' }
        shape_float: { fg: '#e8a04c' attr: 'b' }
        shape_garbage: { fg: '#0a0a0b' bg: '#ff5566' attr: 'b' }
        shape_glob_interpolation: { fg: '#ff7a7a' attr: 'b' }
        shape_globpattern: { fg: '#ff7a7a' attr: 'b' }
        shape_int: { fg: '#ff2a3d' attr: 'b' }
        shape_internalcall: { fg: '#c4303f' attr: 'b' }
        shape_keyword: { fg: '#ff2a3d' attr: 'b' }
        shape_list: { fg: '#ff7a7a' attr: 'b' }
        shape_literal: '#e6dcdc'
        shape_match_pattern: '#8aa37b'
        shape_matching_brackets: { attr: 'u' }
        shape_nothing: '#ff5566'
        shape_operator: '#e8a04c'
        shape_or: { fg: '#ff2a3d' attr: 'b' }
        shape_pipe: { fg: '#ff2a3d' attr: 'b' }
        shape_range: { fg: '#e8a04c' attr: 'b' }
        shape_raw_string: { fg: '#8aa37b' attr: 'b' }
        shape_record: { fg: '#c4303f' attr: 'b' }
        shape_redirection: { fg: '#ff2a3d' attr: 'b' }
        shape_signature: { fg: '#c4303f' attr: 'b' }
        shape_string: '#8aa37b'
        shape_string_interpolation: { fg: '#ff7a7a' attr: 'b' }
        shape_table: { fg: '#c4303f' attr: 'b' }
        shape_vardecl: { fg: '#c4303f' attr: 'u' }
        shape_variable: '#ff2a3d'

        foreground: '#e6dcdc'
        background: '#0a0a0b'
        cursor: '#e6dcdc'

        empty: '#7a5256'
        header: { fg: '#c4303f' attr: 'b' }
        hints: '#7a5256'
        leading_trailing_space_bg: { attr: 'n' }
        row_index: { fg: '#ff7a7a' attr: 'b' }
        search_result: { fg: '#0a0a0b' bg: '#c4303f' }
        separator: '#7a5256'
    }
}

# Update the Nushell configuration
export def --env "set color_config" [] {
    $env.config.color_config = (main)
}

# Update terminal colors
export def "update terminal" [] {
    let theme = (main)

    let osc_screen_foreground_color = '10;'
    let osc_screen_background_color = '11;'
    let osc_cursor_color = '12;'

    $"
    (ansi -o $osc_screen_foreground_color)($theme.foreground)(char bel)
    (ansi -o $osc_screen_background_color)($theme.background)(char bel)
    (ansi -o $osc_cursor_color)($theme.cursor)(char bel)
    "
    | str replace --all "\n" ''
    | print -n $"($in)\r"
}

export module activate {
    export-env {
        set color_config
        update terminal
    }
}

# Activate the theme when sourced
use activate

# fzf colours (config.nu sets the rest of FZF_DEFAULT_OPTS)
$env.FZF_DEFAULT_OPTS = $"($env.FZF_DEFAULT_OPTS) --color=bg+:#1a1011,bg:#0a0a0b,spinner:#ff2a3d,hl:#ff5566 --color=fg:#e6dcdc,header:#c4303f,info:#ff7a7a,pointer:#ff2a3d --color=marker:#8aa37b,fg+:#e6dcdc,prompt:#c4303f,hl+:#ff5566"
