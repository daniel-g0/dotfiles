    YAZI_THEME.write_text(content)

def apply_hyprlock(p, prev):
    def hl(c):
        return "rgba({}ff)".format(c.lstrip("#"))
    text = HYPRLOCK_CFG.read_text()
    # All replacements use named-key regex — no prev/cache dependency
    subs = [
        # input-field keys (unique names)
        (r"(outer_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",    rf"\g<1>{hl(p['blue'])}"),
        (r"(inner_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",    rf"\g<1>{hl(p['bg_alt'])}"),
        (r"(font_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",     rf"\g<1>{hl(p['fg'])}"),
        (r"(check_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",    rf"\g<1>{hl(p['green'])}"),
        (r"(fail_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",     rf"\g<1>{hl(p['red'])}"),
        (r"(capslock_color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)", rf"\g<1>{hl(p['yellow'])}"),
        # background block: first `color =` line
        (r"(background\s*\{[^}]*?color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",
         rf"\g<1>{hl(p['bg'])}", re.DOTALL),
        # Clock label (first label block): color = fg
        (r"(#\s*Clock[^\n]*\nlabel\s*\{[^}]*?color\s*=\s*)rgba\([0-9a-fA-F]{6}ff\)",
         rf"\g<1>{hl(p['fg'])}", re.DOTALL),
        # Date + Fortune labels: color = fg_dim (remaining labels after Clock)
    ]
    for item in subs:
        pat, rep = item[0], item[1]
        flags = item[2] if len(item) > 2 else 0
        text = re.sub(pat, rep, text, flags=flags)
    # Date and Fortune labels: all non-Clock labels get fg_dim
    # Replace color = rgba(...) inside label blocks that follow "# Date" or "# Fortune"
    for anchor in ("Date", "Fortune"):
        text = re.sub(
            rf"(#\s*{anchor}[^\n]*\nlabel\s*\{{[^}}]*?color\s*=\s*)rgba\([0-9a-fA-F]{{6}}ff\)",
            rf"\g<1>{hl(p['fg_dim'])}",
            text, flags=re.DOTALL,
        )
    # Pango placeholder ##rrggbb
    old_dim = prev.get("fg_dim", "").lstrip("#")
    new_dim = p["fg_dim"].lstrip("#")
    if old_dim and old_dim != new_dim:
        text = text.replace(f"##{old_dim}", f"##{new_dim}")
    # Always update placeholder to current fg_dim (no prev dependency)
    text = re.sub(r'(foreground=")##[0-9a-fA-F]{6}(")', rf'\g<1>##{p["fg_dim"].lstrip("#")}\2', text)
    HYPRLOCK_CFG.write_text(text)

def apply_cheatsheet(p, prev):
    def ansi_str(c):
        r, g, b = rgb_ints(c)
        return f"38;2;{r};{g};{b}"
    text = CHEATSHEET.read_text()
    # FZF_COLORS — role-based regex on each key=value pair
    fzf_subs = [
        (r'(bg:#)[0-9a-fA-F]{6}',       rf'\g<1>{p["bg"].lstrip("#")}'),
        (r'(bg\+:#)[0-9a-fA-F]{6}',     rf'\g<1>{p["bg_alt"].lstrip("#")}'),
        (r'(spinner:#)[0-9a-fA-F]{6}',  rf'\g<1>{p["accent"].lstrip("#")}'),
        (r'(hl:#)[0-9a-fA-F]{6}',       rf'\g<1>{p["fg_dim"].lstrip("#")}'),
        (r'(?<=[,"])fg:#[0-9a-fA-F]{6}',rf'fg:#{p["fg"].lstrip("#")}'),
        (r'(header:#)[0-9a-fA-F]{6}',   rf'\g<1>{p["fg_dim"].lstrip("#")}'),
        (r'(info:#)[0-9a-fA-F]{6}',     rf'\g<1>{p["blue"].lstrip("#")}'),
        (r'(pointer:#)[0-9a-fA-F]{6}',  rf'\g<1>{p["accent"].lstrip("#")}'),
        (r'(marker:#)[0-9a-fA-F]{6}',   rf'\g<1>{p["cyan"].lstrip("#")}'),
        (r'(fg\+:#)[0-9a-fA-F]{6}',     rf'\g<1>{p["fg"].lstrip("#")}'),
        (r'(prompt:#)[0-9a-fA-F]{6}',   rf'\g<1>{p["blue"].lstrip("#")}'),
        (r'(hl\+:#)[0-9a-fA-F]{6}',     rf'\g<1>{p["cyan"].lstrip("#")}'),
    ]
    for pat, rep in fzf_subs:
        text = re.sub(pat, rep, text)
    # ANSI escape codes prev→new
    for key in ("accent", "blue", "yellow", "fg_dim"):
        old_c = prev.get(key, "")
        if old_c and old_c != p[key]:
            text = text.replace(ansi_str(old_c), ansi_str(p[key]))
    CHEATSHEET.write_text(text)

def apply_nix_menu(p, prev):
    text = NIX_MENU_RASI.read_text()
    # Role-based replacements for variable definitions
    bl = p["blue"].lstrip("#")
    ac = p["accent"].lstrip("#")
    hf, lf, sf = _hls(p["fg"])
    hd, ld, sd = _hls(p["fg_dim"])
    mid_fg = _hex(*colorsys.hls_to_rgb(hf, (lf + ld) / 2, (sf + sd) / 2)).lstrip("#")
    hb, lb, sb = _hls(p["bg"])
    dark_bg = _hex(*colorsys.hls_to_rgb(hb, max(lb * 0.55, 0.025), sb * 0.4)).lstrip("#")

    subs = [
        (r'(blue:\s*#)[0-9a-fA-F]{6}',           rf'\g<1>{bl}'),
        (r'(purple:\s*#)[0-9a-fA-F]{6}',          rf'\g<1>{ac}'),
        (r'(sel-bg:\s*#)[0-9a-fA-F]{6}',          rf'\g<1>{bl}'),
        (r'(border-c:\s*#)[0-9a-fA-F]{6}',        rf'\g<1>{bl}'),
        (r'(fg:\s*#)[0-9a-fA-F]{6}(?=;)',         rf'\g<1>{mid_fg}'),
        (r'(fg-dim:\s*#)[0-9a-fA-F]{6}',          rf'\g<1>{p["fg_dim"].lstrip("#")}'),
    ]
    for pat, rep in subs:
        text = re.sub(pat, rep, text)
    # Replace all remaining hex occurrences prev→new (handles alpha variants too)
    for key in ("blue", "accent", "bg", "fg_dim", "fg"):
        old = prev.get(key, "").lstrip("#")
        new = p[key].lstrip("#")
        if old and old != new:
            text = text.replace(old, new)
    # Window background (very dark, ~f7 opacity) — replace by role regex
    text = re.sub(r'(window\s*\{[^}]*background-color:\s*#)[0-9a-fA-F]{6}',
                  rf'\g<1>{dark_bg}', text, flags=re.DOTALL)
    NIX_MENU_RASI.write_text(text)

def apply_modules(p, prev):
    """Recolour the hard-coded icon colours in modules.jsonc.

    Every palette role is remapped, and both the previous palette and the original
    Tokyo Night values count as "old" (the file ships with Tokyo Night colours that
    were never touched for roles other than accent/blue). One regex pass, so a colour
    shared by two roles can't be replaced twice in a chain.
    """
    text = MODULES_JSON.read_text()
    base = PRESETS["tokyo-night"]
    mapping = {}
    for role in ("accent", "blue", "cyan", "green", "red", "yellow"):
        new = p[role].lstrip("#").lower()
        for old in (base.get(role, ""), prev.get(role, "")):  # prev last, so it wins
            old = old.lstrip("#").lower()
            if old:
                mapping[old] = new
    text = re.sub(
        r"#([0-9a-fA-F]{6})\b",
        lambda m: "#" + mapping.get(m.group(1).lower(), m.group(1)),
        text,
    )
    MODULES_JSON.write_text(text)

NVIM_THEME = DOTFILES / "dev/nvim/lua/themes/dynamic.lua"

def _shade(c, dl):
    h, l, s = _hls(c)
    return _hex(*colorsys.hls_to_rgb(h, max(0.0, min(1.0, l + dl)), s))

def _lua_table(d):
    return "{\n" + "".join(f'  {k} = "{v}",\n' for k, v in d.items()) + "}"

def apply_nvim(p):
    """Generate an NvChad (base46) theme from the palette, so nvim matches every other app — for
    presets and wallpapers alike — then rebuild base46's highlight cache and reload running nvims.

    chadrc.lua is only read at startup and init.lua loads highlights from a precompiled cache
    (stdpath data/nvchad/base46), so just editing the theme name never changed anything: the cache
    has to be recompiled, and open sessions have to be told to reload."""
    bg, bg_alt, fg, dim = p["bg"], p["bg_alt"], p["fg"], p["fg_dim"]
    red, green, yellow = p["red"], p["green"], p["yellow"]
    blue, cyan, accent = p["blue"], p["cyan"], p["accent"]

    base_30 = {
        "white": fg, "darker_black": _shade(bg, -0.02), "black": bg, "black2": _shade(bg, 0.02),
        "one_bg": bg_alt, "one_bg2": _shade(bg_alt, 0.04), "one_bg3": _shade(bg_alt, 0.08),
        "grey": _shade(bg_alt, 0.13), "grey_fg": dim, "grey_fg2": _shade(dim, 0.05),
        "light_grey": _shade(dim, 0.12),
        "red": red, "baby_pink": _shade(red, 0.12), "pink": _shade(accent, 0.10),
        "line": _shade(bg, 0.07),
        "green": green, "vibrant_green": _shade(green, 0.06),
        "blue": blue, "nord_blue": blue,
        "yellow": yellow, "sun": _shade(yellow, 0.05),
        "purple": accent, "dark_purple": _shade(accent, -0.08),
        "teal": cyan, "orange": yellow, "cyan": cyan,
        "statusline_bg": bg_alt, "lightbg": _shade(bg_alt, 0.04),
        "pmenu_bg": accent, "folder_bg": blue,
    }
    base_16 = {
        "base00": bg, "base01": bg_alt, "base02": _shade(bg_alt, 0.06), "base03": dim,
        "base04": _shade(dim, 0.12), "base05": fg, "base06": fg, "base07": fg,
        "base08": red, "base09": yellow, "base0A": yellow, "base0B": green,
        "base0C": cyan, "base0D": blue, "base0E": accent, "base0F": _shade(red, -0.10),
    }
    NVIM_THEME.parent.mkdir(parents=True, exist_ok=True)
    NVIM_THEME.write_text(
        "-- dynamic.lua — generated by apply-theme. Do not edit.\n"
        "local M = {}\n\n"
        f"M.base_30 = {_lua_table(base_30)}\n\n"
        f"M.base_16 = {_lua_table(base_16)}\n\n"
        'M.type = "dark"\n\n'
        'M = require("base46").override_theme(M, "dynamic")\n\n'
        "return M\n"
    )

    text = NVIM_CHADRC.read_text()
    text = re.sub(r'(theme\s*=\s*")[^"]*"', r'\g<1>dynamic"', text, count=1)
    NVIM_CHADRC.write_text(text)

    nvim = shutil.which("nvim")
    if not nvim:
        return
    # 1. rebuild the cache that new sessions load at startup
    subprocess.run(
        [nvim, "--headless", "-c",
         "lua package.loaded['themes.dynamic'] = nil; require('base46').compile()", "-c", "qa"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    # 2. repaint sessions that are already open (<Cmd> so it works in any mode)
    # The colours nvim actually shows come from tokyonight fed by lua/palette.lua (plugins/init.lua
    # forces that colorscheme over base46), so reload that; base46 first for its UI integrations.
    reload_lua = ("<Cmd>lua package.loaded['themes.dynamic'] = nil; "
                  "pcall(function() require('nvchad.themes.utils').reload_theme('dynamic') end); "
                  "require('palette').reload()<CR>")
    for sock in glob.glob(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000"), "nvim.*.0")):
        try:
            subprocess.run([nvim, "--server", sock, "--remote-send", reload_lua],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        except subprocess.TimeoutExpired:
            pass

# Colours other than the six palette roles that the shipped (Tokyo Night) files use, and the role
# each one stands for.
TOKYO_EXTRA = {
    "7dcfff": "cyan", "ff9e64": "yellow", "414868": "fg_dim", "292e42": "bg_alt",
    "16161e": "bg", "2a2a36": "bg_alt", "a9b1d6": "fg",
}

def _role_map(p, prev, extra=None):
    """old hex -> new hex for every palette role.

    "Old" is both the original Tokyo Night value (what the files ship with) and the previously
    applied palette. Applied in a single regex pass by _recolor_text, so a colour shared by two
    roles can't be replaced twice in a chain."""
    base = PRESETS["tokyo-night"]
    mapping = {}
    for role in ("bg", "bg_alt", "fg", "fg_dim", "accent", "blue", "cyan", "green", "red", "yellow"):
        new = p[role].lstrip("#").lower()
        for old in (base.get(role, ""), prev.get(role, "")):  # prev last, so it wins
            old = old.lstrip("#").lower()
            if old:
                mapping[old] = new
    for old, role in (extra or {}).items():
        mapping[old] = p[role].lstrip("#").lower()
    return mapping

def _recolor_text(text, mapping):
    return re.sub(r"#([0-9a-fA-F]{6})\b",
                  lambda m: "#" + mapping.get(m.group(1).lower(), m.group(1)), text)

# App files with hard-coded palette colours and no dedicated applier above.
RECOLOR_FILES = [
    DOTFILES / "apps/whosthere/config.yaml",
    DOTFILES / "apps/cava/config-vibe",
    DOTFILES / "wm/wayland/swaync/style.css",
    DOTFILES / "wm/wayland/waybar/scripts/nix-menu",
    DOTFILES / "wm/wayland/waybar/scripts/nix-menu-settings",
    DOTFILES / "wm/wayland/waybar/scripts/nix-menu-power",
    DOTFILES / "wm/wayland/waybar/scripts/nix-options",
    DOTFILES / "wm/wayland/waybar/scripts/ganancias",
]

def apply_recolor(p, prev):
    mapping = _role_map(p, prev, TOKYO_EXTRA)
    for f in RECOLOR_FILES:
        if not f.exists():
            continue
        old = f.read_text()
        new = _recolor_text(old, mapping)
        if new != old:
            f.write_text(new)

NU_TEMPLATE = DOTFILES / "shell/nushell/themes/tokyo-night.nu"
NU_DYNAMIC  = DOTFILES / "shell/nushell/themes/dynamic.nu"

def apply_nushell(p):
    """themes/dynamic.nu = the Tokyo Night nushell theme recoloured from the palette, plus fzf colours.
    config.nu sources it; it is read when a shell starts, so already-open shells keep the old colours."""
    text = _recolor_text(NU_TEMPLATE.read_text(), _role_map(p, {}, TOKYO_EXTRA))
    text = "# dynamic.nu — generated by apply-theme from tokyo-night.nu. Do not edit.\n" + text
    text += (
        "\n# fzf colours (config.nu sets the rest of FZF_DEFAULT_OPTS)\n"
        f'$env.FZF_DEFAULT_OPTS = $"($env.FZF_DEFAULT_OPTS) '
        f'--color=bg+:{p["bg_alt"]},bg:{p["bg"]},spinner:{p["accent"]},hl:{p["red"]} '
        f'--color=fg:{p["fg"]},header:{p["blue"]},info:{p["cyan"]},pointer:{p["accent"]} '
        f'--color=marker:{p["green"]},fg+:{p["fg"]},prompt:{p["blue"]},hl+:{p["red"]}"\n'
    )
    NU_DYNAMIC.write_text(text)

STATUSLINE = DOTFILES / "dev/claude/statusline-command.sh"

def apply_statusline(p):
    """Claude Code status line uses raw ANSI truecolor constants."""
    if not STATUSLINE.exists():
        return
    text = STATUSLINE.read_text()
    for var, role in (("BLUE", "blue"), ("GREEN", "green"), ("YELLOW", "yellow"),
                      ("PURPLE", "accent"), ("CYAN", "cyan")):
        h = p[role]
        r, g, b = (int(h[i:i + 2], 16) for i in (1, 3, 5))
        line = f"{var}='\\033[38;2;{r};{g};{b}m'  # {h}"
        text = re.sub(rf"^{var}='\\033\[38;2;\d+;\d+;\d+m'.*$", lambda m, l=line: l, text, flags=re.M)
    STATUSLINE.write_text(text)

def apply_brave(p):
    live = find_brave_ext()
    if not live:
        raise RuntimeError("Brave Tokyo Night extension not found — is it installed?")

    def rgb(c):
        r, g, b = rgb_ints(c)
        return [r, g, b]

    # Derive a slightly darker bg for inactive/incognito frames
    hb, lb, sb = _hls(p["bg"])
    bg_dark = _hex(*colorsys.hls_to_rgb(hb, max(lb * 0.75, 0.02), sb))

    data = json.loads(BRAVE_REPO.read_text())
    theme = data.setdefault("theme", {})
    colors = theme.setdefault("colors", {})

    # Frame / chrome
    colors["frame"]                              = rgb(p["bg"])
    colors["frame_inactive"]                     = rgb(bg_dark)
    colors["frame_incognito"]                    = rgb(p["bg_alt"])
    colors["frame_incognito_inactive"]           = rgb(p["bg_alt"])
    colors["tab_background_frame"]               = rgb(p["bg"])

    # Toolbar / omnibox
    colors["toolbar"]                            = rgb(p["bg_alt"])
    colors["toolbar_text"]                       = rgb(p["fg"])
    colors["toolbar_button_icon"]                = rgb(p["fg"])
    colors["omnibox_background"]                 = rgb(p["bg_alt"])
    colors["omnibox_text"]                       = rgb(p["fg"])
    colors["button_background"]                  = rgb(p["bg_alt"])

    # Tabs
    colors["background_tab"]                     = rgb(p["bg_alt"])
    colors["background_tab_inactive"]            = rgb(p["bg_alt"])
    colors["background_tab_incognito"]           = rgb(p["bg_alt"])
    colors["background_tab_incognito_inactive"]  = rgb(p["bg_alt"])
    colors["tab_text"]                           = rgb(p["fg"])
    colors["tab_background_text"]                = rgb(p["fg_dim"])
    colors["tab_background_text_inactive"]       = rgb(p["fg_dim"])
    colors["tab_background_text_incognito"]      = rgb(p["fg_dim"])
    colors["tab_background_text_incognito_inactive"] = rgb(p["fg_dim"])

    # NTP (new tab page)
    colors["ntp_background"]                     = rgb(p["bg"])
    colors["ntp_header"]                         = rgb(p["bg_alt"])
    colors["ntp_text"]                           = rgb(p["fg"])
    colors["ntp_link"]                           = rgb(p["blue"])

    # Bookmarks
    colors["bookmark_text"]                      = rgb(p["blue"])

    # Disable tints that override our colors
    tints = theme.setdefault("tints", {})
    tints["background_tab"]   = [-1, -1, -1]
    tints["frame"]            = [-1, -1, -1]
    tints["frame_inactive"]   = [-1, -1, -1]

    updated = json.dumps(data, indent=2)
    BRAVE_REPO.write_text(updated)
    (live / "manifest.json").write_text(updated)

    for pak in live.glob("*.pak"):
        pak.unlink()

def apply_claude_code(p):
    # Claude Code only has dark/light/auto — pick based on background luminance
    mode = "dark" if lum(p["bg"]) < 0.5 else "light"
    data = json.loads(CLAUDE_CFG.read_text())
    data["theme"] = mode
    CLAUDE_CFG.write_text(json.dumps(data, indent=2))

# ── Reload ────────────────────────────────────────────────────────────────────

def reload_tools():
    # Waybar: full restart (launch script handles output detection)
    subprocess.Popen(
        "pkill waybar; sleep 0.3; bash ~/.config/waybar/launch",
        shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    # Kitty: listen_on appends the PID (/tmp/kitty-<pid>), so every running instance has its
    # own socket — address them all. --configured makes the colours stick for new windows too;
    # load-config reloads tab_bar.py. Short timeout so a stale socket can't hang the run.
    for sock in glob.glob("/tmp/kitty-*"):
        for args in (["set-colors", "--all", "--configured", str(KITTY_DYN)], ["load-config"]):
            try:
                subprocess.run(["kitty", "@", f"--to=unix:{sock}", *args],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            except subprocess.TimeoutExpired:
                pass
    # Swaync: reload CSS
    subprocess.Popen(["swaync-client", "-R"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Cava: reload config
    subprocess.Popen(["pkill", "-SIGUSR1", "cava"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# ── Entry point ───────────────────────────────────────────────────────────────

