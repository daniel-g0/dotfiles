def main():
    if len(sys.argv) < 2:
        sys.exit("Usage: apply-theme <wallpaper-path>|--preset <name>")

    CACHE.mkdir(parents=True, exist_ok=True)
    prev_file = CACHE / "palette.json"
    prev = json.loads(prev_file.read_text()) if prev_file.exists() else {
        "bg": "#1a1b26", "bg_alt": "#24283b", "fg": "#c0caf5", "fg_dim": "#565f89",
        "accent": "#bb9af7", "blue": "#7aa2f7", "cyan": "#2ac3de", "green": "#9ece6a",
        "red": "#f7768e", "yellow": "#e0af68",
    }

    preset_name = None
    if sys.argv[1] == "--preset":
        if len(sys.argv) < 3 or sys.argv[2] not in PRESETS:
            sys.exit(f"Usage: apply-theme --preset <{'|'.join(PRESETS)}>")
        preset_name = sys.argv[2]
        palette = dict(PRESETS[preset_name])
        palette.setdefault("wall", "")
        (CACHE / "last-preset").write_text(preset_name)
        print(f"apply-theme: applying preset '{preset_name}' …", flush=True)
    else:
        wall = sys.argv[1]
        print(f"apply-theme: extracting palette from {Path(wall).name} …", flush=True)
        colors  = extract_colors(wall)
        palette = map_palette(colors, wall)
        (CACHE / "last-wallpaper").write_text(wall)
        (CACHE / "last-preset").write_text("")  # wallpaper-driven — no preset name

    prev_file.write_text(json.dumps(palette, indent=2))
    steps = [
        ("waybar CSS",      lambda p: apply_waybar(p)),
        ("waybar border",   lambda p: apply_waybar_border(p)),
        ("kitty",           lambda p: apply_kitty(p)),
        ("swaync",          lambda p: apply_swaync(p)),
        ("rofi",            lambda p: apply_rofi(p)),
        ("cava",            lambda p: apply_cava(p)),
        ("btop",            lambda p: apply_btop(p)),
        ("starship",        lambda p: apply_starship(p, prev)),
        ("hyprland border", lambda p: apply_hyprland(p)),
        # brave: extension-based theming not reliable — skipped
        ("fastfetch",       lambda p: apply_fastfetch(p, prev)),
        ("yazi",            lambda p: apply_yazi(p)),
        ("hyprlock",        lambda p: apply_hyprlock(p, prev)),
        ("cheatsheet",      lambda p: apply_cheatsheet(p, prev)),
        ("nix-menu",        lambda p: apply_nix_menu(p, prev)),
        ("modules.jsonc",   lambda p: apply_modules(p, prev)),
        ("nvim",            lambda p: apply_nvim(p)),
        ("nushell + fzf",   lambda p: apply_nushell(p)),
        ("claude statusline", lambda p: apply_statusline(p)),
        ("other app colours", lambda p: apply_recolor(p, prev)),
        ("claude-code",     lambda p: apply_claude_code(p)),
    ]
    for label, fn in steps:
        try:
            fn(palette)
            print(f"  ✓ {label}", flush=True)
        except Exception as e:
            print(f"  ✗ {label}: {e}", flush=True)

    reload_tools()
    print("  ✓ tools reloaded", flush=True)
    print(f"\nPalette saved to {CACHE}/palette.json", flush=True)

if __name__ == "__main__":
    main()
