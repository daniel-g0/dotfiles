CACHE        = Path.home() / ".cache/dynamic-theme"

# ── Colour math ───────────────────────────────────────────────────────────────

def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def _hex(r, g, b):
    return "#{:02x}{:02x}{:02x}".format(int(r*255), int(g*255), int(b*255))

def _hls(h):
    return colorsys.rgb_to_hls(*_rgb(h))

def lum(c):  return _hls(c)[1]
def sat(c):  return _hls(c)[2]
def hue(c):  return _hls(c)[0]

def clamp_dark(c, max_l=0.11):
    h, l, s = _hls(c)
    return _hex(*colorsys.hls_to_rgb(h, min(l, max_l), s * 0.30)) if l > max_l else c

def clamp_light(c, min_l=0.82):
    h, l, s = _hls(c)
    return _hex(*colorsys.hls_to_rgb(h, max(l, min_l), s * 0.20)) if l < min_l else c

def boost(c, target_s=0.72, target_l=0.62):
    """Push accent colours out of muddy painting territory."""
    h, l, s = _hls(c)
    new_s = max(s, target_s)
    new_l = target_l if l < 0.35 else max(0.50, min(0.72, l))
    return _hex(*colorsys.hls_to_rgb(h, new_l, new_s))

def rgba_css(c, a):
    r, g, b = _rgb(c)
    return "rgba({}, {}, {}, {})".format(int(r*255), int(g*255), int(b*255), a)

def rgba8(c, alpha_hex="ee"):
    return "rgba({}{})".format(c.lstrip("#"), alpha_hex)

def rgb_ints(c):
    r, g, b = _rgb(c)
    return int(r*255), int(g*255), int(b*255)

# ── Brave extension discovery ─────────────────────────────────────────────────

def find_brave_ext():
    """Return the live Brave extension dir for our Tokyo Night theme, or None."""
    base = Path.home() / ".config/BraveSoftware/Brave-Browser/Default/Extensions"
    if not base.exists():
        return None
    for ext_dir in base.iterdir():
        if not ext_dir.is_dir():
            continue
        for version_dir in ext_dir.iterdir():
            manifest = version_dir / "manifest.json"
            if not manifest.exists():
                continue
            try:
                data = json.loads(manifest.read_text())
                if "tokyo night" in data.get("name", "").lower():
                    return version_dir
            except Exception:
                pass
    return None

# ── Extraction ────────────────────────────────────────────────────────────────

def extract_colors(wall, n=16):
    out = subprocess.run(
        ["magick", str(wall), "+dither", "-kmeans", str(n),
         "-unique-colors", "txt:-"],
        capture_output=True, text=True
    ).stdout
    colors = []
    for line in out.splitlines():
        for tok in line.split():
            if tok.startswith("#") and len(tok) == 7:
                colors.append(tok.lower())
                break
    return list(dict.fromkeys(colors))[:n] or ["#1a1b26"]

# ── Palette mapping ───────────────────────────────────────────────────────────

def map_palette(colors, wall=""):
    by_lum = sorted(colors, key=lum)
    n = len(by_lum)

    # bg: darkest colour, floored at l=0.04 (never pure black)
    bg     = clamp_dark(by_lum[0], 0.10)
    h0, l0, s0 = _hls(bg)
    if l0 < 0.04:
        bg = _hex(*colorsys.hls_to_rgb(h0, 0.05, s0))

    bg_alt = clamp_dark(by_lum[min(2, n-1)], 0.18)

    # fg: lightest colour, capped at l=0.93 (never pure white)
    fg     = clamp_light(by_lum[-1], 0.82)
    hf, lf, sf = _hls(fg)
    if lf > 0.93:
        fg = _hex(*colorsys.hls_to_rgb(hf, 0.90, sf))

    # fg_dim: must be readable — between 35% and 65% lightness
    raw_dim = by_lum[max(-3, -n)]
    hd, ld, sd = _hls(raw_dim)
    ld = max(0.35, min(0.65, ld))
    fg_dim = _hex(*colorsys.hls_to_rgb(hd, ld, max(sd, 0.05)))

    # Mid-range colours, ranked by saturation — these become accent hues
    lo, hi = max(1, n // 5), max(n - 1, n * 3 // 4)
    mid = by_lum[lo:hi] or by_lum[1:-1] or by_lum

    accents, seen = [], []
    for c in sorted(mid, key=sat, reverse=True):
        h = hue(c)
        close = any(min(abs(h-s), 1.0-abs(h-s)) < 0.08 for s in seen)
        if not close:
            accents.append(boost(c))
            seen.append(h)
        if len(accents) == 4:
            break

    # Fallback to Tokyo Night hues if palette too monochrome
    fb = ["#bb9af7", "#7aa2f7", "#2ac3de", "#9ece6a"]
    while len(accents) < 4:
        accents.append(fb[len(accents)])

    return {
        "bg":     bg,
        "bg_alt": bg_alt,
        "fg":     fg,
        "fg_dim": fg_dim,
        "accent": accents[0],
        "blue":   accents[1],
        "cyan":   accents[2],
        "green":  accents[3],
        "red":    "#f7768e",
        "yellow": "#e0af68",
        "wall":   str(wall),
    }

# ── Tool writers ──────────────────────────────────────────────────────────────

def apply_waybar(p):
    bg_r, bg_g, bg_b = rgb_ints(p["bg"])
    module_bg = "rgba({}, {}, {}, 0.92)".format(bg_r, bg_g, bg_b)
    content = f"""/* Dynamic theme — generated by apply-theme. Do not edit. */
@define-color foreground     {p["fg"]};
@define-color background     {p["bg"]};
@define-color purple         {p["accent"]};
@define-color blue           {p["blue"]};
@define-color cyan           {p["cyan"]};
@define-color green          {p["green"]};
@define-color red            {p["red"]};
@define-color yellow         {p["yellow"]};
@define-color surface0       {p["bg"]};
@define-color surface1       {p["bg_alt"]};
@define-color surface2       {p["fg_dim"]};
@define-color surface3       {p["fg_dim"]};
@define-color accent         @purple;
@define-color main-bg        @surface0;
@define-color main-fg        @foreground;
@define-color main-br        @surface1;
@define-color hover-bg       @surface1;
@define-color hover-fg       alpha(@foreground, 0.75);
@define-color module-bg      {module_bg};
@define-color inactive       @surface2;
"""
    WAYBAR_DYN.write_text(content)

