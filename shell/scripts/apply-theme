#!/usr/bin/env python3
"""
apply-theme <wallpaper-path>
Extracts a colour palette from a wallpaper and applies it to all tools.
"""

import subprocess, sys, re, json, colorsys
from pathlib import Path

DOTFILES     = Path.home() / "Projects/personal/dotfiles"
WAYBAR_DYN   = DOTFILES / "wm/wayland/waybar/themes/dynamic.css"
KITTY_DYN    = DOTFILES / "apps/kitty/dynamic-colors.conf"
BTOP_DYN     = DOTFILES / "apps/btop/themes/dynamic.theme"
SWAYNC_CSS   = DOTFILES / "wm/wayland/swaync/style.css"
ROFI_RASI    = DOTFILES / "apps/rofi/config.rasi"
CAVA_CFG     = DOTFILES / "apps/cava/config"
STARSHIP_CFG = DOTFILES / "shell/starship/starship.toml"
CACHE        = Path.home() / ".cache/dynamic-theme"

# ── Colour math ───────────────────────────────────────────────────────────────

def _rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) / 255.0 for i in (0, 2, 4))

def _hex(r, g, b):
    return "#{:02x}{:02x}{:02x}".format(int(r*255), int(g*255), int(b*255))

def _hls(h):
    return colorsys.rgb_to_hls(*_rgb(h))

def lum(c):  return _hls(c)[1]
def sat(c):  return _hls(c)[2]
def hue(c):  return _hls(c)[0]

def clamp_dark(c, max_l=0.11):
    h, l, s = _hls(c)
    return _hex(*colorsys.hls_to_rgb(h, min(l, max_l), s * 0.30)) if l > max_l else c

def clamp_light(c, min_l=0.82):
    h, l, s = _hls(c)
    return _hex(*colorsys.hls_to_rgb(h, max(l, min_l), s * 0.20)) if l < min_l else c

def boost(c, target_s=0.72, target_l=0.62):
    """Push accent colours out of muddy painting territory."""
    h, l, s = _hls(c)
    new_s = max(s, target_s)
    new_l = target_l if l < 0.35 else max(0.50, min(0.72, l))
    return _hex(*colorsys.hls_to_rgb(h, new_l, new_s))

def rgba_css(c, a):
    r, g, b = _rgb(c)
    return "rgba({}, {}, {}, {})".format(int(r*255), int(g*255), int(b*255), a)

def rgba8(c, alpha_hex="ee"):
    return "rgba({}{})".format(c.lstrip("#"), alpha_hex)

def rgb_ints(c):
    r, g, b = _rgb(c)
    return int(r*255), int(g*255), int(b*255)

# ── Extraction ────────────────────────────────────────────────────────────────

def extract_colors(wall, n=16):
    out = subprocess.run(
        ["magick", str(wall), "+dither", "-kmeans", str(n),
         "-unique-colors", "txt:-"],
        capture_output=True, text=True
    ).stdout
    colors = []
    for line in out.splitlines():
        for tok in line.split():
            if tok.startswith("#") and len(tok) == 7:
                colors.append(tok.lower())
                break
    return list(dict.fromkeys(colors))[:n] or ["#1a1b26"]

# ── Palette mapping ───────────────────────────────────────────────────────────

def map_palette(colors, wall=""):
    by_lum = sorted(colors, key=lum)
    n = len(by_lum)

    # bg: darkest colour, floored at l=0.04 (never pure black)
    bg     = clamp_dark(by_lum[0], 0.10)
    h0, l0, s0 = _hls(bg)
    if l0 < 0.04:
        bg = _hex(*colorsys.hls_to_rgb(h0, 0.05, s0))

    bg_alt = clamp_dark(by_lum[min(2, n-1)], 0.18)

    # fg: lightest colour, capped at l=0.93 (never pure white)
    fg     = clamp_light(by_lum[-1], 0.82)
    hf, lf, sf = _hls(fg)
    if lf > 0.93:
        fg = _hex(*colorsys.hls_to_rgb(hf, 0.90, sf))

    # fg_dim: must be readable — between 35% and 65% lightness
    raw_dim = by_lum[max(-3, -n)]
    hd, ld, sd = _hls(raw_dim)
    ld = max(0.35, min(0.65, ld))
    fg_dim = _hex(*colorsys.hls_to_rgb(hd, ld, max(sd, 0.05)))

    # Mid-range colours, ranked by saturation — these become accent hues
    lo, hi = max(1, n // 5), max(n - 1, n * 3 // 4)
    mid = by_lum[lo:hi] or by_lum[1:-1] or by_lum

    accents, seen = [], []
    for c in sorted(mid, key=sat, reverse=True):
        h = hue(c)
        close = any(min(abs(h-s), 1.0-abs(h-s)) < 0.08 for s in seen)
        if not close:
            accents.append(boost(c))
            seen.append(h)
        if len(accents) == 4:
            break

    # Fallback to Tokyo Night hues if palette too monochrome
    fb = ["#bb9af7", "#7aa2f7", "#2ac3de", "#9ece6a"]
    while len(accents) < 4:
        accents.append(fb[len(accents)])

    return {
        "bg":     bg,
        "bg_alt": bg_alt,
        "fg":     fg,
        "fg_dim": fg_dim,
        "accent": accents[0],
        "blue":   accents[1],
        "cyan":   accents[2],
        "green":  accents[3],
        "red":    "#f7768e",
        "yellow": "#e0af68",
        "wall":   str(wall),
    }

# ── Tool writers ──────────────────────────────────────────────────────────────

def apply_waybar(p):
    bg_r, bg_g, bg_b = rgb_ints(p["bg"])
    module_bg = "rgba({}, {}, {}, 0.92)".format(bg_r, bg_g, bg_b)
    content = f"""/* Dynamic theme — generated by apply-theme. Do not edit. */
@define-color foreground     {p["fg"]};
@define-color background     {p["bg"]};
@define-color purple         {p["accent"]};
@define-color blue           {p["blue"]};
@define-color cyan           {p["cyan"]};
@define-color green          {p["green"]};
@define-color red            {p["red"]};
@define-color yellow         {p["yellow"]};
@define-color surface0       {p["bg"]};
@define-color surface1       {p["bg_alt"]};
@define-color surface2       {p["fg_dim"]};
@define-color surface3       {p["fg_dim"]};
@define-color accent         @purple;
@define-color main-bg        @surface0;
@define-color main-fg        @foreground;
@define-color main-br        @surface1;
@define-color hover-bg       @surface1;
@define-color hover-fg       alpha(@foreground, 0.75);
@define-color module-bg      {module_bg};
@define-color inactive       @surface2;
"""
    WAYBAR_DYN.write_text(content)

def apply_kitty(p):
    content = f"""# dynamic-colors.conf — generated by apply-theme. Do not edit.
foreground            {p["fg"]}
background            {p["bg"]}
color0                {p["bg_alt"]}
color1                {p["red"]}
color2                {p["green"]}
color3                {p["yellow"]}
color4                {p["blue"]}
color5                {p["accent"]}
color6                {p["cyan"]}
color7                {p["fg"]}
color8                {p["bg_alt"]}
color9                {p["red"]}
color10               {p["green"]}
color11               {p["yellow"]}
color12               {p["blue"]}
color13               {p["accent"]}
color14               {p["cyan"]}
color15               {p["fg"]}
cursor                {p["fg"]}
cursor_text_color     {p["bg"]}
"""
    KITTY_DYN.write_text(content)

def apply_btop(p):
    br, bg_, bb = rgb_ints(p["bg_alt"])
    sel_bg = _hex(br/255 * 1.4, bg_/255 * 1.4, bb/255 * 1.4)
    content = f"""# dynamic.theme — generated by apply-theme. Do not edit.
theme[main_bg]="{p["bg"]}"
theme[main_fg]="{p["fg"]}"
theme[title]="{p["blue"]}"
theme[hi_fg]="{p["blue"]}"
theme[selected_bg]="{p["bg_alt"]}"
theme[selected_fg]="{p["fg"]}"
theme[inactive_fg]="{p["fg_dim"]}"
theme[proc_misc]="{p["green"]}"
theme[cpu_box]="{p["accent"]}"
theme[mem_box]="{p["blue"]}"
theme[net_box]="{p["cyan"]}"
theme[proc_box]="{p["green"]}"
theme[div_line]="{p["bg_alt"]}"
theme[temp_start]="{p["green"]}"
theme[temp_mid]="{p["yellow"]}"
theme[temp_end]="{p["red"]}"
theme[cpu_start]="{p["blue"]}"
theme[cpu_mid]="{p["accent"]}"
theme[cpu_end]="{p["red"]}"
theme[free_start]="{p["green"]}"
theme[free_mid]="{p["blue"]}"
theme[free_end]="{p["accent"]}"
theme[cached_start]="{p["cyan"]}"
theme[cached_mid]="{p["blue"]}"
theme[cached_end]="{p["blue"]}"
theme[available_start]="{p["green"]}"
theme[available_mid]="{p["blue"]}"
theme[available_end]="{p["accent"]}"
theme[used_start]="{p["red"]}"
theme[used_mid]="{p["yellow"]}"
theme[used_end]="{p["green"]}"
theme[download_start]="{p["cyan"]}"
theme[download_mid]="{p["blue"]}"
theme[download_end]="{p["accent"]}"
theme[upload_start]="{p["green"]}"
theme[upload_mid]="{p["yellow"]}"
theme[upload_end]="{p["red"]}"
theme[process_start]="{p["blue"]}"
theme[process_mid]="{p["accent"]}"
theme[process_end]="{p["cyan"]}"
"""
    BTOP_DYN.write_text(content)

def _sub(text, pattern, replacement):
    return re.sub(pattern, replacement, text)

def apply_swaync(p):
    bg_r, bg_g, bg_b = rgb_ints(p["bg"])
    alt_r, alt_g, alt_b = rgb_ints(p["bg_alt"])
    fg_r, fg_g, fg_b = rgb_ints(p["fg"])
    dim_r, dim_g, dim_b = rgb_ints(p["fg_dim"])

    text = SWAYNC_CSS.read_text()
    subs = [
        (r"(--tn-bg:\s*)#[0-9a-fA-F]{6}",          rf"\g<1>{p['bg']}"),
        (r"(--tn-bg-alt:\s*)#[0-9a-fA-F]{6}",       rf"\g<1>{p['bg_alt']}"),
        (r"(--tn-surface:\s*)#[0-9a-fA-F]{6}",      rf"\g<1>{p['bg_alt']}"),
        (r"(--tn-surface2:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg_dim']}"),
        (r"(--tn-surface3:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg_dim']}"),
        (r"(--tn-fg:\s*)#[0-9a-fA-F]{6}",           rf"\g<1>{p['fg']}"),
        (r"(--tn-fg-dim:\s*)rgba\([^)]+\)",          rf"\g<1>{rgba_css(p['fg'], 0.55)}"),
        (r"(--tn-accent:\s*)#[0-9a-fA-F]{6}",       rf"\g<1>{p['accent']}"),
        (r"(--tn-blue:\s*)#[0-9a-fA-F]{6}",         rf"\g<1>{p['blue']}"),
        (r"(--tn-cyan:\s*)#[0-9a-fA-F]{6}",         rf"\g<1>{p['cyan']}"),
        (r"(--tn-green:\s*)#[0-9a-fA-F]{6}",        rf"\g<1>{p['green']}"),
        (r"(--tn-red:\s*)#[0-9a-fA-F]{6}",          rf"\g<1>{p['red']}"),
        (r"(--cc-bg:\s*)rgba\([^)]+\)",              rf"\g<1>{rgba_css(p['bg'], 0.97)}"),
        (r"(--noti-border-color:\s*)rgba\([^)]+\)",  rf"\g<1>{rgba_css(p['bg_alt'], 0.9)}"),
        (r"(--noti-bg:\s*)[\d]+,\s*[\d]+,\s*[\d]+", rf"\g<1>{bg_r}, {bg_g}, {bg_b}"),
        (r"(--noti-bg-opaque:\s*)rgb\([^)]+\)",      rf"\g<1>rgb({bg_r}, {bg_g}, {bg_b})"),
        (r"(--noti-bg-darker:\s*)rgb\([^)]+\)",      rf"\g<1>rgb({int(bg_r*0.85)}, {int(bg_g*0.85)}, {int(bg_b*0.85)})"),
        (r"(--noti-bg-hover:\s*)rgb\([^)]+\)",       rf"\g<1>rgb({alt_r}, {alt_g}, {alt_b})"),
        (r"(--noti-bg-focus:\s*)rgba\([^)]+\)",      rf"\g<1>{rgba_css(p['bg_alt'], 0.7)}"),
        (r"(--text-color:\s*)#[0-9a-fA-F]{6}",      rf"\g<1>{p['fg']}"),
        (r"(--bg-selected:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['blue']}"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    SWAYNC_CSS.write_text(text)

def apply_rofi(p):
    text = ROFI_RASI.read_text()
    subs = [
        (r"(bg:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['bg']}"),
        (r"(bg-alt:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['bg_alt']}"),
        (r"(fg:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg']}"),
        (r"(fg-dim:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['fg_dim']}"),
        (r"(blue:\s*)#[0-9a-fA-F]{6}",   rf"\g<1>{p['blue']}"),
        (r"(purple:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['accent']}"),
        (r"(cyan:\s*)#[0-9a-fA-F]{6}",   rf"\g<1>{p['cyan']}"),
        (r"(green:\s*)#[0-9a-fA-F]{6}",  rf"\g<1>{p['green']}"),
        (r"(red:\s*)#[0-9a-fA-F]{6}",    rf"\g<1>{p['red']}"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    ROFI_RASI.write_text(text)

def apply_cava(p):
    text = CAVA_CFG.read_text()
    subs = [
        (r"(background\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['bg']}'"),
        (r"(gradient_color_1\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['accent']}'"),
        (r"(gradient_color_2\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['blue']}'"),
        (r"(gradient_color_3\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['cyan']}'"),
        (r"(gradient_color_4\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['green']}'"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    CAVA_CFG.write_text(text)

def apply_starship(p, prev):
    """prev = last applied palette (for knowing which colours to replace)."""
    text = STARSHIP_CFG.read_text()
    pairs = [
        (prev["accent"], p["accent"]),
        (prev["blue"],   p["blue"]),
        (prev["green"],  p["green"]),
    ]
    for old, new in pairs:
        if old != new:
            text = text.replace(old, new)
    STARSHIP_CFG.write_text(text)

def apply_hyprland(p):
    a, b, c = p["accent"], p["blue"], p["cyan"]
    active   = f"{rgba8(a)} {rgba8(b)} {rgba8(c)} {rgba8(a)} 90deg"
    inactive = f"{rgba8(a,'44')} {rgba8(b,'44')} {rgba8(c,'44')} {rgba8(a,'44')} 90deg"
    for key, val in [("general:col.active_border", active),
                     ("general:col.inactive_border", inactive)]:
        subprocess.run(["hyprctl", "keyword", key, val],
                       capture_output=True)

def apply_waybar_border(p):
    """Update waybar CSS gradient border to match new palette."""
    style = DOTFILES / "wm/wayland/waybar/style.css"
    text  = style.read_text()
    new_grad = (
        f"linear-gradient(90deg, {p['blue']}, {p['accent']}, "
        f"{p['cyan']}, {p['green']}, {p['blue']}, {p['accent']}, "
        f"{p['cyan']}, {p['blue']})"
    )
    text = re.sub(
        r"linear-gradient\(90deg,[^)]+\)",
        new_grad,
        text
    )
    # Update glow box-shadow colours
    br, bg_, bb = rgb_ints(p["blue"])
    ar, ag, ab  = rgb_ints(p["accent"])
    text = re.sub(
        r"0 0 16px rgba\([^)]+\),\s*\n\s*0 0 32px rgba\([^)]+\)",
        f"0 0 16px rgba({br}, {bg_}, {bb}, 0.30),\n\t\t0 0 32px rgba({ar}, {ag}, {ab}, 0.12)",
        text
    )
    style.write_text(text)

# ── Reload ────────────────────────────────────────────────────────────────────

def reload_tools():
    # Waybar: full restart (launch script handles output detection)
    subprocess.Popen(
        "pkill waybar; sleep 0.3; bash ~/.config/waybar/launch",
        shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    # Kitty: live colour swap via remote control
    subprocess.Popen(
        ["kitty", "@", "--to=unix:/tmp/kitty", "set-colors",
         "--all", str(KITTY_DYN)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    # Swaync: reload CSS
    subprocess.Popen(["swaync-client", "-R"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Cava: reload config
    subprocess.Popen(["pkill", "-SIGUSR1", "cava"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 2:
        sys.exit("Usage: apply-theme <wallpaper-path>")

    wall = sys.argv[1]
    print(f"apply-theme: extracting palette from {Path(wall).name} …", flush=True)

    colors  = extract_colors(wall)
    palette = map_palette(colors, wall)

    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "last-wallpaper").write_text(wall)

    # Load previous palette BEFORE overwriting — needed for starship replacement
    prev_file = CACHE / "palette.json"
    prev = json.loads(prev_file.read_text()) if prev_file.exists() else {
        "accent": "#bb9af7", "blue": "#7aa2f7", "green": "#9ece6a",
    }
    prev_file.write_text(json.dumps(palette, indent=2))

    steps = [
        ("waybar CSS",      lambda p: apply_waybar(p)),
        ("waybar border",   lambda p: apply_waybar_border(p)),
        ("kitty",           lambda p: apply_kitty(p)),
        ("swaync",          lambda p: apply_swaync(p)),
        ("rofi",            lambda p: apply_rofi(p)),
        ("cava",            lambda p: apply_cava(p)),
        ("btop",            lambda p: apply_btop(p)),
        ("starship",        lambda p: apply_starship(p, prev)),
        ("hyprland border", lambda p: apply_hyprland(p)),
    ]
    for label, fn in steps:
        try:
            fn(palette)
            print(f"  ✓ {label}", flush=True)
        except Exception as e:
            print(f"  ✗ {label}: {e}", flush=True)

    reload_tools()
    print("  ✓ tools reloaded", flush=True)
    print(f"\nPalette saved to {CACHE}/palette.json", flush=True)

if __name__ == "__main__":
    main()
