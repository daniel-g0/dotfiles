theme[main_bg]="{p["bg"]}"
theme[main_fg]="{p["fg"]}"
theme[title]="{p["blue"]}"
theme[hi_fg]="{p["blue"]}"
theme[selected_bg]="{p["bg_alt"]}"
theme[selected_fg]="{p["fg"]}"
theme[inactive_fg]="{p["fg_dim"]}"
theme[proc_misc]="{p["green"]}"
theme[cpu_box]="{p["accent"]}"
theme[mem_box]="{p["blue"]}"
theme[net_box]="{p["cyan"]}"
theme[proc_box]="{p["green"]}"
theme[div_line]="{p["bg_alt"]}"
theme[temp_start]="{p["green"]}"
theme[temp_mid]="{p["yellow"]}"
theme[temp_end]="{p["red"]}"
theme[cpu_start]="{p["blue"]}"
theme[cpu_mid]="{p["accent"]}"
