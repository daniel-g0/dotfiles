def _sub(text, pattern, replacement):
    return re.sub(pattern, replacement, text)

def apply_swaync(p):
    bg_r, bg_g, bg_b = rgb_ints(p["bg"])
    alt_r, alt_g, alt_b = rgb_ints(p["bg_alt"])
    fg_r, fg_g, fg_b = rgb_ints(p["fg"])
    dim_r, dim_g, dim_b = rgb_ints(p["fg_dim"])

    text = SWAYNC_CSS.read_text()
    subs = [
        (r"(--tn-bg:\s*)#[0-9a-fA-F]{6}",          rf"\g<1>{p['bg']}"),
        (r"(--tn-bg-alt:\s*)#[0-9a-fA-F]{6}",       rf"\g<1>{p['bg_alt']}"),
        (r"(--tn-surface:\s*)#[0-9a-fA-F]{6}",      rf"\g<1>{p['bg_alt']}"),
        (r"(--tn-surface2:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg_dim']}"),
        (r"(--tn-surface3:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg_dim']}"),
        (r"(--tn-fg:\s*)#[0-9a-fA-F]{6}",           rf"\g<1>{p['fg']}"),
        (r"(--tn-fg-dim:\s*)rgba\([^)]+\)",          rf"\g<1>{rgba_css(p['fg'], 0.55)}"),
        (r"(--tn-accent:\s*)#[0-9a-fA-F]{6}",       rf"\g<1>{p['accent']}"),
        (r"(--tn-blue:\s*)#[0-9a-fA-F]{6}",         rf"\g<1>{p['blue']}"),
        (r"(--tn-cyan:\s*)#[0-9a-fA-F]{6}",         rf"\g<1>{p['cyan']}"),
        (r"(--tn-green:\s*)#[0-9a-fA-F]{6}",        rf"\g<1>{p['green']}"),
        (r"(--tn-red:\s*)#[0-9a-fA-F]{6}",          rf"\g<1>{p['red']}"),
        (r"(--cc-bg:\s*)rgba\([^)]+\)",              rf"\g<1>{rgba_css(p['bg'], 0.97)}"),
        (r"(--noti-border-color:\s*)rgba\([^)]+\)",  rf"\g<1>{rgba_css(p['bg_alt'], 0.9)}"),
        (r"(--noti-bg:\s*)[\d]+,\s*[\d]+,\s*[\d]+", rf"\g<1>{bg_r}, {bg_g}, {bg_b}"),
        (r"(--noti-bg-opaque:\s*)rgb\([^)]+\)",      rf"\g<1>rgb({bg_r}, {bg_g}, {bg_b})"),
        (r"(--noti-bg-darker:\s*)rgb\([^)]+\)",      rf"\g<1>rgb({int(bg_r*0.85)}, {int(bg_g*0.85)}, {int(bg_b*0.85)})"),
        (r"(--noti-bg-hover:\s*)rgb\([^)]+\)",       rf"\g<1>rgb({alt_r}, {alt_g}, {alt_b})"),
        (r"(--noti-bg-focus:\s*)rgba\([^)]+\)",      rf"\g<1>{rgba_css(p['bg_alt'], 0.7)}"),
        (r"(--text-color:\s*)#[0-9a-fA-F]{6}",      rf"\g<1>{p['fg']}"),
        (r"(--bg-selected:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['blue']}"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    SWAYNC_CSS.write_text(text)

def apply_rofi(p):
    text = ROFI_RASI.read_text()
    subs = [
        (r"(bg:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['bg']}"),
        (r"(bg-alt:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['bg_alt']}"),
        (r"(fg:\s*)#[0-9a-fA-F]{6}",     rf"\g<1>{p['fg']}"),
        (r"(fg-dim:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['fg_dim']}"),
        (r"(blue:\s*)#[0-9a-fA-F]{6}",   rf"\g<1>{p['blue']}"),
        (r"(purple:\s*)#[0-9a-fA-F]{6}", rf"\g<1>{p['accent']}"),
        (r"(cyan:\s*)#[0-9a-fA-F]{6}",   rf"\g<1>{p['cyan']}"),
        (r"(green:\s*)#[0-9a-fA-F]{6}",  rf"\g<1>{p['green']}"),
        (r"(red:\s*)#[0-9a-fA-F]{6}",    rf"\g<1>{p['red']}"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    ROFI_RASI.write_text(text)

def apply_cava(p):
    text = CAVA_CFG.read_text()
    subs = [
        (r"(background\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['bg']}'"),
        (r"(gradient_color_1\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['accent']}'"),
        (r"(gradient_color_2\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['blue']}'"),
        (r"(gradient_color_3\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['cyan']}'"),
        (r"(gradient_color_4\s*=\s*)'#[0-9a-fA-F]{6}'", rf"\g<1>'{p['green']}'"),
    ]
    for pat, rep in subs:
        text = _sub(text, pat, rep)
    CAVA_CFG.write_text(text)

def apply_starship(p, prev):
    """prev = last applied palette (for knowing which colours to replace)."""
    text = STARSHIP_CFG.read_text()
    pairs = [
        (prev["accent"], p["accent"]),
        (prev["blue"],   p["blue"]),
        (prev["green"],  p["green"]),
    ]
    for old, new in pairs:
        if old != new:
            text = text.replace(old, new)
    STARSHIP_CFG.write_text(text)

def apply_hyprland(p):
    a, b, c = p["accent"], p["blue"], p["cyan"]

    def lua_colors(alpha):
        cols = [rgba8(a, alpha), rgba8(b, alpha), rgba8(c, alpha), rgba8(a, alpha)]
        return "{" + ",".join(f"'{x}'" for x in cols) + "}"

    active_lua   = "hl.config({{general={{col={{active_border={{colors={c},angle=0}}}}}}}})" .format(c=lua_colors('ee'))
    inactive_lua = "hl.config({{general={{col={{inactive_border={{colors={c},angle=0}}}}}}}})" .format(c=lua_colors('44'))
    for lua in [active_lua, inactive_lua]:
        subprocess.run(["hyprctl", "eval", lua], capture_output=True)

def apply_waybar_border(p):
    """Update waybar CSS gradient border to match new palette."""
    style = DOTFILES / "wm/wayland/waybar/style.css"
    text  = style.read_text()
    new_grad = (
        f"linear-gradient(90deg, {p['blue']}, {p['accent']}, "
        f"{p['cyan']}, {p['green']}, {p['blue']}, {p['accent']}, "
        f"{p['cyan']}, {p['blue']})"
    )
    text = re.sub(
        r"linear-gradient\(90deg,[^)]+\)",
        new_grad,
        text
    )
    # Update glow box-shadow colours
    br, bg_, bb = rgb_ints(p["blue"])
    ar, ag, ab  = rgb_ints(p["accent"])
    text = re.sub(
        r"0 0 16px rgba\([^)]+\),\s*\n\s*0 0 32px rgba\([^)]+\)",
        f"0 0 16px rgba({br}, {bg_}, {bb}, 0.30),\n\t\t0 0 32px rgba({ar}, {ag}, {ab}, 0.12)",
        text
    )
    style.write_text(text)

def apply_fastfetch(p, prev):
    def ansi(c):
        r, g, b = rgb_ints(c)
        return f"38;2;{r};{g};{b}"
    text = FASTFETCH_CFG.read_text()
    for old, new in [(ansi(prev["blue"]), ansi(p["blue"])),
                     (ansi(prev["accent"]), ansi(p["accent"]))]:
        if old != new:
            text = text.replace(old, new)
    # Handle initial TN cyan (#7dcfff) on first run
    initial_at = "38;2;125;207;255"
    if initial_at in text:
        text = text.replace(initial_at, ansi(p["cyan"]))
    elif prev.get("cyan") and ansi(prev["cyan"]) != ansi(p["cyan"]):
        text = text.replace(ansi(prev["cyan"]), ansi(p["cyan"]))
    FASTFETCH_CFG.write_text(text)

def apply_yazi(p):
    bg, bg_alt, fg, fg_dim = p["bg"], p["bg_alt"], p["fg"], p["fg_dim"]
    blue, accent, cyan     = p["blue"], p["accent"], p["cyan"]
    green, red, yellow     = p["green"], p["red"], p["yellow"]
    hf, lf, sf = _hls(fg)
    hd, ld, sd = _hls(fg_dim)
    mid_fg = _hex(*colorsys.hls_to_rgb(hf, (lf + ld) / 2, (sf + sd) / 2))
    hb, lb, sb = _hls(bg_alt)
    border = _hex(*colorsys.hls_to_rgb(hb, min(lb * 1.6, 0.30), max(sb * 0.6, 0.04)))
    content = f"""# Dynamic theme — generated by apply-theme. Do not edit.

[mgr]
cwd = {{ fg = "{blue}" }}

hovered         = {{ fg = "{bg}", bg = "{blue}" }}
preview_hovered = {{ bg = "{bg}", underline = true }}

find_keyword  = {{ fg = "{yellow}", bg = "{bg}", bold = true, italic = true, underline = true }}
find_position = {{ fg = "{yellow}", bg = "{bg}", bold = true, italic = true }}

symlink_target = {{ fg = "{cyan}", bg = "{bg}" }}

marker_copied   = {{ fg = "{green}", bg = "{green}" }}
marker_cut      = {{ fg = "{red}", bg = "{red}" }}
marker_marked   = {{ fg = "{yellow}", bg = "{yellow}" }}
marker_selected = {{ fg = "{blue}", bg = "{blue}" }}

count_copied   = {{ fg = "{bg}", bg = "{green}" }}
count_cut      = {{ fg = "{bg}", bg = "{red}" }}
count_selected = {{ fg = "{bg}", bg = "{blue}" }}

border_symbol = "│"
border_style  = {{ fg = "{border}" }}

syntect_theme = "base16-ocean.dark"

[indicator]
parent  = {{ fg = "{fg_dim}", bg = "{bg}" }}
current = {{ fg = "{fg}", bg = "{bg}" }}
preview = {{ fg = "{fg_dim}", bg = "{bg}" }}

[tabs]
active   = {{ fg = "{bg}", bg = "{blue}" }}
