#!/usr/bin/env python3
"""
apply-theme <wallpaper-path>
Extracts a colour palette from a wallpaper and applies it to all tools.
"""

import subprocess, sys, re, json, colorsys
from pathlib import Path

DOTFILES     = Path.home() / "Projects/personal/dotfiles"
WAYBAR_DYN   = DOTFILES / "wm/wayland/waybar/themes/dynamic.css"
KITTY_DYN    = DOTFILES / "apps/kitty/dynamic-colors.conf"
BTOP_DYN     = DOTFILES / "apps/btop/themes/dynamic.theme"
SWAYNC_CSS   = DOTFILES / "wm/wayland/swaync/style.css"
ROFI_RASI    = DOTFILES / "apps/rofi/config.rasi"
CAVA_CFG     = DOTFILES / "apps/cava/config"
STARSHIP_CFG = DOTFILES / "shell/starship/starship.toml"
BRAVE_REPO   = DOTFILES / "apps/brave/tokyo-night-storm/manifest.json"
YAZI_THEME   = DOTFILES / "apps/yazi/theme.toml"
FASTFETCH_CFG= DOTFILES / "apps/fastfetch/config.jsonc"
HYPRLOCK_CFG = DOTFILES / "wm/wayland/hypr/hyprlock.conf"
NVIM_CHADRC  = DOTFILES / "dev/nvim/lua/chadrc.lua"
CHEATSHEET   = DOTFILES / "wm/wayland/hypr/cheatsheet.sh"
