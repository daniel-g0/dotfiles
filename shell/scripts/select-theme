    monochrome)
      swatch_row "bg / text" "#000000" "#f2f2f2" "#6b6b6b" "#111111"
      swatch_row "accents"   "#ffffff" "#b5b5b5" "#d2d2d2" "#828282" "#9c9c9c" "#ebebeb"
