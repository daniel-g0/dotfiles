#!/usr/bin/env bash
# Theme picker — fzf over named presets, applies via apply-theme --preset
set -euo pipefail

APPLY="$HOME/Projects/personal/dotfiles/shell/scripts/apply-theme"
THEMES=(tokyo-night warm-earth catppuccin nord gruvbox rose-pine dracula one-dark monokai solarized-dark everforest ayu-dark kanagawa nightfox palenight horizon night-owl material-ocean crimson claude)

# swatch <#rrggbb> <label>
swatch() {
  local hex="${1#'#'}" label="$2"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  printf '\033[48;2;%d;%d;%dm   \033[0m %s\n' "$r" "$g" "$b" "$label"
}

# row of swatches on one line: swatch_row <label> <hex> <hex> ...
swatch_row() {
  local label="$1"; shift
  printf '%-12s' "$label"
  for hex in "$@"; do
    local h="${hex#'#'}"
    local r=$((16#${h:0:2})) g=$((16#${h:2:2})) b=$((16#${h:4:2}))
    printf '\033[48;2;%d;%d;%dm   \033[0m ' "$r" "$g" "$b"
  done
  printf '\n'
}

preview() {
  case "$1" in
    tokyo-night)
      swatch_row "bg / text" "#1a1b26" "#c0caf5" "#565f89" "#24283b"
      swatch_row "accents"   "#bb9af7" "#7aa2f7" "#2ac3de" "#9ece6a" "#e0af68" "#f7768e"
      ;;
    warm-earth)
      swatch_row "bg / text" "#1b1817" "#f2e3b1" "#8a7560" "#282420"
      swatch_row "accents"   "#e35e58" "#e3a258" "#d4956a" "#9ece6a" "#e0af68" "#f7768e"
      ;;
    catppuccin)
      swatch_row "bg / text" "#1e1e2e" "#cdd6f4" "#6c7086" "#313244"
      swatch_row "accents"   "#cba6f7" "#89b4fa" "#89dceb" "#a6e3a1" "#f9e2af" "#f38ba8"
      ;;
    nord)
      swatch_row "bg / text" "#2e3440" "#eceff4" "#4c566a" "#3b4252"
      swatch_row "accents"   "#b48ead" "#5e81ac" "#88c0d0" "#a3be8c" "#ebcb8b" "#bf616a"
      ;;
    gruvbox)
      swatch_row "bg / text" "#282828" "#ebdbb2" "#928374" "#3c3836"
      swatch_row "accents"   "#d3869b" "#83a598" "#8ec07c" "#b8bb26" "#fabd2f" "#fb4934"
      ;;
    rose-pine)
      swatch_row "bg / text" "#191724" "#e0def4" "#6e6a86" "#26233a"
      swatch_row "accents"   "#c4a7e7" "#9ccfd8" "#31748f" "#31748f" "#f6c177" "#eb6f92"
      ;;
    dracula)
      swatch_row "bg / text" "#282a36" "#f8f8f2" "#6272a4" "#44475a"
      swatch_row "accents"   "#ff79c6" "#6272a4" "#8be9fd" "#50fa7b" "#f1fa8c" "#ff5555"
      ;;
    one-dark)
      swatch_row "bg / text" "#282c34" "#abb2bf" "#5c6370" "#2c313a"
      swatch_row "accents"   "#c678dd" "#61afef" "#56b6c2" "#98c379" "#e5c07b" "#e06c75"
      ;;
    monokai)
      swatch_row "bg / text" "#272822" "#f8f8f2" "#75715e" "#3e3d32"
      swatch_row "accents"   "#f92672" "#66d9e8" "#a1efe4" "#a6e22e" "#e6db74" "#f92672"
      ;;
    solarized-dark)
      swatch_row "bg / text" "#002b36" "#839496" "#586e75" "#073642"
      swatch_row "accents"   "#d33682" "#268bd2" "#2aa198" "#859900" "#b58900" "#dc322f"
      ;;
    everforest)
      swatch_row "bg / text" "#2d353b" "#d3c6aa" "#7a8478" "#343f44"
      swatch_row "accents"   "#e67e80" "#7fbbb3" "#83c092" "#a7c080" "#dbbc7f" "#e67e80"
      ;;
    ayu-dark)
      swatch_row "bg / text" "#0a0e14" "#b3b1ad" "#3d424d" "#0d1017"
      swatch_row "accents"   "#ff8f40" "#59c2ff" "#95e6cb" "#aad94c" "#e6b673" "#f07178"
      ;;
    kanagawa)
      swatch_row "bg / text" "#1f1f28" "#dcd7ba" "#727169" "#2a2a37"
      swatch_row "accents"   "#957fb8" "#7e9cd8" "#6a9589" "#76946a" "#c0a36e" "#c34043"
      ;;
    nightfox)
      swatch_row "bg / text" "#192330" "#cdcecf" "#71839b" "#212e3f"
      swatch_row "accents"   "#c099ff" "#82aaff" "#86e1fc" "#b8db87" "#ffc777" "#fc5d7c"
      ;;
    palenight)
      swatch_row "bg / text" "#292d3e" "#a6accd" "#676e95" "#2f3347"
      swatch_row "accents"   "#c792ea" "#82b1ff" "#89ddff" "#c3e88d" "#ffcb6b" "#f07178"
      ;;
    horizon)
      swatch_row "bg / text" "#1c1e26" "#d5d8da" "#6c6f93" "#232530"
      swatch_row "accents"   "#e95678" "#25b0bc" "#25b0bc" "#09f7a0" "#fab795" "#e95678"
      ;;
    night-owl)
      swatch_row "bg / text" "#011627" "#d6deeb" "#4b6479" "#0e2233"
      swatch_row "accents"   "#c792ea" "#82aaff" "#7fdbca" "#addb67" "#ecc48d" "#ff5874"
      ;;
    material-ocean)
      swatch_row "bg / text" "#0f111a" "#8f93a2" "#464b5d" "#1a1c25"
      swatch_row "accents"   "#c792ea" "#82aaff" "#89ddff" "#c3e88d" "#ffcb6b" "#ff5370"
      ;;
    crimson)
      swatch_row "bg / text" "#1a0f10" "#f0d5d8" "#8a5f66" "#261518"
      swatch_row "accents"   "#e05560" "#9b7fc9" "#7fbfb5" "#7db87d" "#d4965a" "#e05560"
      ;;
    claude)
      swatch_row "bg / text" "#1a1510" "#e8dcc8" "#7a6e5e" "#252017"
      swatch_row "accents"   "#d97757" "#c4885f" "#8faa90" "#8fa876" "#d4a843" "#c44b4b"
      ;;
  esac
}

export -f swatch swatch_row preview

# Build fzf color string from current dynamic palette
FZF_PAL_COLORS=""
_pal="$HOME/.cache/dynamic-theme/palette.json"
[ -f "$_pal" ] && FZF_PAL_COLORS=$(python3 -c "
import json, sys
p = json.load(open('$_pal'))
h = lambda c: c.lstrip('#')
keys = ['bg','bg_alt','fg','fg_dim','blue','accent','cyan']
if not all(k in p for k in keys):
    sys.exit(0)
print(','.join([
    f\"bg:#{h(p['bg'])}\",
    f\"bg+:#{h(p['bg_alt'])}\",
    f\"fg:#{h(p['fg'])}\",
    f\"fg+:#{h(p['fg'])}\",
    f\"border:#{h(p['blue'])}\",
    f\"prompt:#{h(p['accent'])}\",
    f\"pointer:#{h(p['accent'])}\",
    f\"info:#{h(p['cyan'])}\",
    f\"hl:#{h(p['accent'])}\",
    f\"hl+:#{h(p['accent'])}\",
    f\"separator:#{h(p['bg_alt'])}\",
    f\"header:#{h(p['blue'])}\",
]))
") 2>/dev/null || true

# Find position of current preset so fzf cursor lands on it
CURRENT_POS=1
_last="$HOME/.cache/dynamic-theme/last-preset"
if [ -f "$_last" ]; then
  _cur=$(cat "$_last")
  if [ -n "$_cur" ]; then
    for _i in "${!THEMES[@]}"; do
      [ "${THEMES[$_i]}" = "$_cur" ] && CURRENT_POS=$((_i + 1)) && break
    done
  fi
fi

FZF_EXTRA_OPTS=(--bind "load:pos:$CURRENT_POS")
[ -n "$FZF_PAL_COLORS" ] && FZF_EXTRA_OPTS+=(--color="$FZF_PAL_COLORS")

chosen=$(printf '%s\n' "${THEMES[@]}" \
  | fzf \
      --prompt="  Palette: " \
      --height=100% \
      --border=rounded \
      --ansi \
      --preview='preview {}' \
      --preview-window=down:4:wrap \
      --no-sort \
      "${FZF_EXTRA_OPTS[@]}" \
  ) || exit 0

[ -z "$chosen" ] && exit 0

echo "Applying $chosen…"
exec "$APPLY" --preset "$chosen"
