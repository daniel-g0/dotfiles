#!/usr/bin/env bash
# Theme picker — fzf over named presets, applies via apply-theme --preset
set -euo pipefail

APPLY="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/apply-theme"
THEMES=(tokyo-night warm-earth catppuccin nord gruvbox rose-pine dracula one-dark monokai solarized-dark everforest ayu-dark kanagawa nightfox palenight horizon night-owl material-ocean crimson claude redline monochrome github-dark synthwave oxocarbon poimandres vesper iceberg zenburn cyberpunk sunset deep-ocean sakura matrix)

# swatch <#rrggbb> <label>
swatch() {
  local hex="${1#'#'}" label="$2"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  printf '\033[48;2;%d;%d;%dm   \033[0m %s\n' "$r" "$g" "$b" "$label"
}

# row of swatches on one line: swatch_row <label> <hex> <hex> ...
swatch_row() {
  local label="$1"; shift
  printf '%-12s' "$label"
  for hex in "$@"; do
    local h="${hex#'#'}"
    local r=$((16#${h:0:2})) g=$((16#${h:2:2})) b=$((16#${h:4:2}))
    printf '\033[48;2;%d;%d;%dm   \033[0m ' "$r" "$g" "$b"
  done
  printf '\n'
}

preview() {
