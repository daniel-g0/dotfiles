      swatch_row "accents"   "#dc8cc3" "#8cd0d3" "#93e0e3" "#7f9f7e" "#f0dfaf" "#cc9393"
      ;;
    cyberpunk)
      swatch_row "bg / text" "#0b0b14" "#e0f7ff" "#5a6a8a" "#161626"
      swatch_row "accents"   "#ff2e97" "#00e5ff" "#00ffd5" "#39ff14" "#fcee0a" "#ff3860"
      ;;
    sunset)
      swatch_row "bg / text" "#1c1420" "#f6e6e0" "#8f7482" "#2a1d2e"
