    sakura)
      swatch_row "bg / text" "#1f1a1e" "#f3e4ea" "#8c7480" "#2b2429"
      swatch_row "accents"   "#f4a6c0" "#c9a0dc" "#9fd8d0" "#b5d6a7" "#f2cf9a" "#e8607a"
      ;;
    matrix)
      swatch_row "bg / text" "#050a06" "#c8f7d0" "#3e6b4a" "#0c1710"
      swatch_row "accents"   "#20e070" "#33ff99" "#80ffcf" "#00ff41" "#d6e86a" "#ff4d4d"
      ;;
  esac
}

export -f swatch swatch_row preview

# Build fzf color string from current dynamic palette
FZF_PAL_COLORS=""
_pal="$HOME/.cache/dynamic-theme/palette.json"
[ -f "$_pal" ] && FZF_PAL_COLORS=$(python3 -c "
import json, sys
p = json.load(open('$_pal'))
h = lambda c: c.lstrip('#')
keys = ['bg','bg_alt','fg','fg_dim','blue','accent','cyan']
if not all(k in p for k in keys):
    sys.exit(0)
print(','.join([
    f\"bg:#{h(p['bg'])}\",
    f\"bg+:#{h(p['bg_alt'])}\",
    f\"fg:#{h(p['fg'])}\",
    f\"fg+:#{h(p['fg'])}\",
    f\"border:#{h(p['blue'])}\",
    f\"prompt:#{h(p['accent'])}\",
    f\"pointer:#{h(p['accent'])}\",
    f\"info:#{h(p['cyan'])}\",
    f\"hl:#{h(p['accent'])}\",
    f\"hl+:#{h(p['accent'])}\",
    f\"separator:#{h(p['bg_alt'])}\",
    f\"header:#{h(p['blue'])}\",
]))
") 2>/dev/null || true

# Find position of current preset so fzf cursor lands on it
CURRENT_POS=1
_last="$HOME/.cache/dynamic-theme/last-preset"
if [ -f "$_last" ]; then
  _cur=$(cat "$_last")
  if [ -n "$_cur" ]; then
    for _i in "${!THEMES[@]}"; do
      [ "${THEMES[$_i]}" = "$_cur" ] && CURRENT_POS=$((_i + 1)) && break
    done
  fi
fi

FZF_EXTRA_OPTS=(--bind "load:pos:$CURRENT_POS")
[ -n "$FZF_PAL_COLORS" ] && FZF_EXTRA_OPTS+=(--color="$FZF_PAL_COLORS")

chosen=$(printf '%s\n' "${THEMES[@]}" \
  | fzf \
      --prompt="  Palette: " \
      --height=100% \
      --border=rounded \
      --ansi \
      --preview='preview {}' \
      --preview-window=down:4:wrap \
      --no-sort \
      "${FZF_EXTRA_OPTS[@]}" \
  ) || exit 0

[ -z "$chosen" ] && exit 0

echo "Applying $chosen…"
exec "$APPLY" --preset "$chosen"
