/* Nix menu — Tokyo Night dropdown */

* {
    bg:        #0d0d14f7;
    fg:        #b49292;
    fg-dim:    #7a5256;
    blue:      #c4303f;
    purple:    #ff2a3d;
    sel-bg:    #c4303f26;
    border-c:  #c4303f40;

    background-color: transparent;
    text-color:       #a9b1d6;
    font:             "JetBrainsMono Nerd Font 13";
}

window {
    location:         northwest;
    anchor:           northwest;
    x-offset:         8px;
    y-offset:         40px;
    width:            220px;
    background-color: #060606f7;
    border-radius:    16px;
    border:           1px;
    border-color:     #c4303f40;
    padding:          6px;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
    padding:          0px;
    spacing:          0px;
}

listview {
    background-color: transparent;
    lines:            7;
    columns:          1;
    scrollbar:        false;
    spacing:          2px;
    padding:          2px;
}

element {
    background-color: transparent;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          12px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal   { background-color: transparent; text-color: #a9b1d6; }
element selected.normal { background-color: #c4303f26;   text-color: #c4303f; }

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
