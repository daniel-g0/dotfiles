#!/usr/bin/env bash
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
PRIMARY=$(hyprctl monitors -j 2>/dev/null | jq -r 'sort_by(.id) | .[0].name // empty')
[[ -z "$PRIMARY" ]] && PRIMARY="eDP-1"

GAP=$(hyprctl getoption general:gaps_out -j 2>/dev/null | jq -r '.css // empty' | awk '{print $1}')
GAP=${GAP:-20}

# Always start minimal: nix (top) · desktop number (center) · moon/power (bottom).
# User clicks the number to expand (toggle-layout writes new CSS; reload_style_on_change picks it up).
LAYOUT="${XDG_RUNTIME_DIR:-/tmp}/waybar-layout.css"
rm -f /tmp/waybar-mode
printf '#left, #left * { font-size: 0; padding: 0; margin: 0; min-height: 0; min-width: 0; color: transparent; border: none; }\n#right, #right * { font-size: 0; padding: 0; margin: 0; min-height: 0; min-width: 0; color: transparent; border: none; }\n#custom-user { margin: 0; }\n#custom-power { margin: 0; }\n' > "$LAYOUT"

TMP=$(mktemp --suffix=.jsonc)
trap "rm -f $TMP" EXIT

sed -e "s|\"reload_style_on_change\": true|\"output\": \"$PRIMARY\", \"reload_style_on_change\": true|" \
    -e "s|\"margin\": \"[^\"]*\"|\"margin\": \"$GAP 4\"|" \
    "$HOME/.config/waybar/config.jsonc" > "$TMP"

exec waybar --config "$TMP"
