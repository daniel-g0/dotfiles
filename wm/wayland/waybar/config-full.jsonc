{
	"layer": "top",
	"position": "right",
	"margin": "20 4",
	"spacing": 0,
	"height": 0,
	"mode": "dock",
	"width": 40,
	"reload_style_on_change": true,

	// Full layout: all icons visible. Click desktop number to collapse back to minimal.
	"modules-left":   ["custom/user", "group/left"],
	"modules-center": ["custom/desktop"],
	"modules-right":  ["group/right", "custom/power"],

	"include": ["~/.config/waybar/modules.jsonc"]
}
