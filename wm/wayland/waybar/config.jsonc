{
	"layer": "top",
	"position": "top",
	"margin": "5 20",
	"spacing": 0,
	"height": 0,
	"mode": "dock",
	"reload_style_on_change": true,

	"modules-left":   ["custom/user", "hyprland/workspaces", "hyprland/window"],
	"modules-center": ["custom/eyecare", "clock"],
	"modules-right":  ["temperature", "cpu", "memory", "pulseaudio#output", "network", "custom/vpn", "custom/notifications", "group/laptop", "custom/power"],

	"include": ["~/.config/waybar/modules.jsonc"]
}
