{
	"layer": "top",
	"position": "right",
	"margin": "20 4", // top/bottom = Hyprland gaps_out, so the bar lines up with the windows (launch sets it from Hyprland)
	"spacing": 0,
	"height": 0,
	"mode": "dock",
	"width": 32,
	"reload_style_on_change": true,

	// nix · gap · stats + clock · gap · desktop number · gap · icons · gap · power, all four gaps equal.
	// The desktop number is alone in the centre box so it sits at the true vertical centre (a centre box
	// is centred as a whole). The top stack hangs from the top, the bottom one from the bottom; the
	// gaps under nix / above power are margins that `launch` computes from the monitor height
	// (waybar-layout.css), which makes the two free gaps beside the number equal to them.
	"modules-left":   ["custom/user", "group/left"],
	"modules-center": ["custom/desktop"],
	"modules-right":  ["group/right", "custom/power"],

	"include": ["~/.config/waybar/modules.jsonc"]
}
