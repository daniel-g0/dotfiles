{
	"layer": "top",
	"position": "right",
	"margin": "8 4",
	"spacing": 0,
	"height": 0,
	"mode": "dock",
	"width": 32,
	"reload_style_on_change": true,

	"modules-left":   ["custom/user"],
	"modules-center": ["group/left", "group/time", "group/right"],
