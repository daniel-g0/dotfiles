#!/usr/bin/env bash
THEME="$HOME/.config/waybar/styles/nix-menu.rasi"

choice=$(printf \
"<span color='#e8a04c'>󰠮</span>  <span color='#e8a04c'>Todo</span>
<span color='#c4303f'>󰓅</span>  <span color='#c4303f'>Statistics</span>
<span color='#ff2a3d'>󰂚</span>  <span color='#ff2a3d'>Notifications</span>
<span color='#ff7a7a'>󰒓</span>  <span color='#ff7a7a'>Settings</span>
<span color='#ff5566'>󰤄</span>  <span color='#ff5566'>Power</span>" \
| rofi -dmenu -i -p "" -no-custom -markup-rows -theme "$THEME")

case "$choice" in
    *Todo*)
        kitty --class todo -e bash -c \
            'task; echo; read -rp "  [a]dd · [#] done · Enter close: " x
             [[ $x =~ ^[0-9]+$ ]] && task done "$x" && task
             [[ $x == a\ * ]]     && task add "${x#a }" && task'
        ;;
    *Statistics*)
        kitty --class stats -T "Statistics" -e btop
        ;;
    *Notifications*)
        swaync-client -t
        ;;
    *Settings*)
        bash "$HOME/.config/waybar/scripts/nix-menu-settings"
        ;;
    *Power*)
        bash "$HOME/.config/waybar/scripts/nix-menu-power"
        ;;
esac
