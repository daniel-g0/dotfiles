#!/usr/bin/env bash
THEME="$HOME/.config/waybar/styles/nix-menu.rasi"

choice=$(printf \
"<span color='#f2c76e'>󰠮</span>  <span color='#f2c76e'>Todo</span>
<span color='#3d9bd9'>󰓅</span>  <span color='#3d9bd9'>Statistics</span>
<span color='#7aa5ff'>󰂚</span>  <span color='#7aa5ff'>Notifications</span>
<span color='#4fd6e0'>󰒓</span>  <span color='#4fd6e0'>Settings</span>
<span color='#f0647a'>󰤄</span>  <span color='#f0647a'>Power</span>" \
| rofi -dmenu -i -p "" -no-custom -markup-rows -theme "$THEME")

case "$choice" in
    *Todo*)
        kitty --class todo -e bash -c \
            'task; echo; read -rp "  [a]dd · [#] done · Enter close: " x
             [[ $x =~ ^[0-9]+$ ]] && task done "$x" && task
             [[ $x == a\ * ]]     && task add "${x#a }" && task'
        ;;
    *Statistics*)
        kitty --class stats -T "Statistics" -e btop
        ;;
    *Notifications*)
        swaync-client -t
        ;;
    *Settings*)
        bash "$HOME/.config/waybar/scripts/nix-menu-settings"
        ;;
    *Power*)
        bash "$HOME/.config/waybar/scripts/nix-menu-power"
        ;;
esac
