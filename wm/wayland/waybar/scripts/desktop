#!/usr/bin/env python3
"""Current desktop number for waybar (custom/desktop).

Event-driven: listens on Hyprland's socket2 and prints one JSON line whenever the
workspace changes. Pure python3 — no socat/jq, neither is installed system-wide.

split-monitor-workspaces numbers each monitor's workspaces in blocks of COUNT
(monitor 2 = 11-20, ...), so fold the id back to 1..COUNT. Keep COUNT in sync with
workspace_count in hyprland.lua.
"""
import json, os, socket, subprocess, sys

COUNT = 10
EVENTS = ("workspace", "focusedmon", "moveworkspace", "createworkspace", "destroyworkspace")

runtime = os.environ["XDG_RUNTIME_DIR"]
sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
if not sig:
    dirs = sorted(os.scandir(f"{runtime}/hypr"), key=lambda d: d.stat().st_mtime, reverse=True)
    sig = dirs[0].name


def emit():
    out = subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True).stdout
    try:
        wid = int(json.loads(out)["id"])
    except (ValueError, KeyError):
        return
    print(json.dumps({"text": str((wid - 1) % COUNT + 1)}), flush=True)


emit()
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(f"{runtime}/hypr/{sig}/.socket2.sock")
for line in sock.makefile("r", errors="replace"):
    if line.startswith(EVENTS):
        emit()
