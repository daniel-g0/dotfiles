#!/usr/bin/env bash
# Toggle waybar between minimal (nix+number+moon) and full (all icons).
# Writes to layout.css; reload_style_on_change:true picks it up — no waybar restart.
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
STATE="/tmp/waybar-mode"
LAYOUT="${XDG_RUNTIME_DIR:-/tmp}/waybar-layout.css"

# Minimal CSS: collapse #left and #right groups to zero height.
# #right #pulseaudio uses double-ID (specificity 0-2-0-0) to beat #pulseaudio.output/.input (0-1-1-0).
MINIMAL='#left, #left * { font-size: 0; padding: 0; margin: 0; min-height: 0; min-width: 0; color: transparent; border: none; }
#right, #right * { font-size: 0; padding: 0; margin: 0; min-height: 0; min-width: 0; color: transparent; border: none; }
#right #pulseaudio { font-size: 0; padding: 0; margin: 0; min-height: 0; min-width: 0; color: transparent; border: none; }
#custom-user { margin: 0; }
#custom-power { margin: 0; }'

if [[ -f "$STATE" ]]; then
    rm "$STATE"
    printf '%s\n' "$MINIMAL" > "$LAYOUT"
else
    touch "$STATE"
    # Read MH and GAP cached by launch (avoids hyprctl dep in on-click env).
    read -r MH GAP < /tmp/waybar-screen 2>/dev/null || { MH=1080; GAP=20; }
    [[ -z "$MH" || "$MH" -lt 400 ]] && MH=1080
    [[ -z "$GAP" ]] && GAP=20
    # Top stack: nix (35.4) + 6 icons (temp 34.7, mem 35.4, cpu 35.4, disk 34.0, backlight 34.7, battery 34.7)
    # = 244.4. A gpu slot (34.0) only counts when nvidia-smi exists.
    GPU_SLOT=$(which nvidia-smi &>/dev/null && echo 34.0 || echo 0)
    TOP_H=$(awk -v g="$GPU_SLOT" 'BEGIN { printf "%.1f", 244.4 + g }')
    # Bottom stack: 6 icons (bluetooth 34.0, out 35.4, in 34.0, network 35.4, vpn 34.0, bell 34.7) + power (35.4)
    # = 242.9. Same count of slots as the top one, so both sides get the same spacing.
    BOT_H=242.9
    CLOCK_H=42.7  # centre box: two text lines (13px) + 2×4px padding
    awk -v mh="$MH" -v gap="$GAP" -v top_h="$TOP_H" -v bot_h="$BOT_H" -v clock_h="$CLOCK_H" 'BEGIN {
        half     = (mh - 2*gap - 4 - clock_h) / 2
        top_free = half - top_h          # space between top stack and clock
        bot_free = half - bot_h          # space between clock and bottom stack
        mu       = top_free / 2;  if (mu < 0) mu = 0   # equal gaps: nix→stats = stats→clock
        mp       = bot_free / 2;  if (mp < 0) mp = 0   # equal gaps: clock→icons = icons→power
        printf "#custom-user  { margin: 0 0 %.0fpx; }\n#custom-power { margin: %.0fpx 0 0; }\n", mu, mp
    }' > "$LAYOUT"
fi
