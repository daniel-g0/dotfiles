#!/usr/bin/env bash
THEME="$HOME/.config/waybar/styles/nix-menu.rasi"

choice=$(printf \
"<span color='#c4303f'>󰌾</span>  <span color='#c4303f'>Lock</span>
<span color='#e8a04c'>󰤄</span>  <span color='#e8a04c'>Suspend</span>
<span color='#ff2a3d'>󰒲</span>  <span color='#ff2a3d'>Hibernate</span>
<span color='#e8a04c'>󰑓</span>  <span color='#e8a04c'>Reboot</span>
<span color='#ff5566'>󰐥</span>  <span color='#ff5566'>Shutdown</span>
<span color='#e6dcdc'>󰍃</span>  <span color='#e6dcdc'>Logout</span>" \
| rofi -dmenu -i -p "<span color='#ff5566'>󰤄  Power</span>" -no-custom -markup-rows -theme "$THEME")

case "$choice" in
    *Lock*)      loginctl lock-session ;;
    *Suspend*)   systemctl suspend ;;
    *Hibernate*) systemctl hibernate ;;
    *Reboot*)    systemctl reboot ;;
    *Shutdown*)  systemctl poweroff ;;
    *Logout*)    loginctl terminate-user "$USER" ;;
esac
