#!/usr/bin/env bash
# NixOS options fzf menu — runs inside kitty

FZF_COLORS="--color=bg+:#1a1011,bg:#0a0a0b,spinner:#ff2a3d,hl:#7a5256,fg:#e6dcdc,header:#7a5256,info:#c4303f,pointer:#ff2a3d,marker:#ff7a7a,fg+:#e6dcdc,prompt:#c4303f,hl+:#ff7a7a"

CHOICE=$(printf '%s\n' \
    "󰏫  Edit Config" \
    "󰑓  Rebuild Switch" \
    "󰙦  Rebuild Test" \
    "󰚰  Update Flake" \
    "󰩺  Garbage Collect" \
    "󰋚  Generations" \
    | fzf $FZF_COLORS \
        --ansi \
        --border=rounded \
        --prompt="  NixOS › " \
        --header=" NixOS Options — ESC to cancel" \
        --header-first \
        --no-multi \
        --height=100% \
        --layout=reverse)

[ -z "$CHOICE" ] && exit 0

case "$CHOICE" in
    *"Edit Config"*)
        nvim "$(readlink -f /etc/nixos/configuration.nix)"
        ;;
    *"Rebuild Switch"*)
        sudo nixos-rebuild switch 2>&1 | tee "$HOME/.local/state/nix-rebuild.log"
        echo; echo "Press Enter to close..."; read
        ;;
    *"Rebuild Test"*)
        sudo nixos-rebuild test 2>&1 | tee "$HOME/.local/state/nix-test.log"
        echo; echo "Press Enter to close..."; read
        ;;
    *"Update Flake"*)
        cd /etc/nixos && sudo nix flake update 2>&1 | tee "$HOME/.local/state/nix-update.log"
        echo; echo "Press Enter to close..."; read
        ;;
    *"Garbage Collect"*)
        sudo nix-collect-garbage --delete-older-than 7d 2>&1 | tee "$HOME/.local/state/nix-gc.log"
        echo; echo "Press Enter to close..."; read
        ;;
    *"Generations"*)
        sudo nix-env --list-generations --profile /nix/var/nix/profiles/system
        echo; echo "Press Enter to close..."; read
        ;;
esac
