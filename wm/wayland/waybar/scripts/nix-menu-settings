#!/usr/bin/env bash
THEME="$HOME/.config/waybar/styles/nix-menu.rasi"

choice=$(printf \
"<span color='#c4303f'>󰤨</span>  <span color='#c4303f'>Network</span>
<span color='#ff7a7a'>󰂯</span>  <span color='#ff7a7a'>Bluetooth</span>
<span color='#8aa37b'>󰕾</span>  <span color='#8aa37b'>Volume</span>
<span color='#ff2a3d'>󰍬</span>  <span color='#ff2a3d'>Mic</span>
<span color='#e8a04c'>󰦝</span>  <span color='#e8a04c'>VPN</span>
<span color='#e8a04c'>󰃠</span>  <span color='#e8a04c'>Brightness</span>
<span color='#8aa37b'>󰁹</span>  <span color='#8aa37b'>Battery</span>" \
| rofi -dmenu -i -p "<span color='#ff7a7a'>  Settings</span>" -no-custom -markup-rows -theme "$THEME")

case "$choice" in
    *Network*)    kitty --class settings -T "Network" -e nmtui ;;
    *Bluetooth*)  blueman-manager ;;
    *Volume*)     pavucontrol ;;
    *Mic*)        pavucontrol --tab=4 ;;
    *VPN*)        kitty --class settings -T "VPN" -e bash "$HOME/.config/waybar/scripts/vpnc-menu" ;;
    *Brightness*) kitty --class settings -T "Brightness" -e bash -c \
                    'echo "Current: $(brightnessctl g) / $(brightnessctl m)"
                     read -rp "Set % (0-100): " v
                     [[ $v =~ ^[0-9]+$ ]] && brightnessctl s "${v}%"' ;;
    *Battery*)    kitty --class settings -T "Battery" -e bash -c \
                    'upower -i $(upower -e | grep BAT) | grep -E "state|percentage|time"; read' ;;
esac
