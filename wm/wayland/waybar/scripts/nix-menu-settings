#!/usr/bin/env bash
THEME="$HOME/.config/waybar/styles/nix-menu.rasi"

choice=$(printf \
"<span color='#3d9bd9'>󰤨</span>  <span color='#3d9bd9'>Network</span>
<span color='#4fd6e0'>󰂯</span>  <span color='#4fd6e0'>Bluetooth</span>
<span color='#58d6a0'>󰕾</span>  <span color='#58d6a0'>Volume</span>
<span color='#7aa5ff'>󰍬</span>  <span color='#7aa5ff'>Mic</span>
<span color='#f2c76e'>󰦝</span>  <span color='#f2c76e'>VPN</span>
<span color='#f2c76e'>󰃠</span>  <span color='#f2c76e'>Brightness</span>
<span color='#58d6a0'>󰁹</span>  <span color='#58d6a0'>Battery</span>" \
| rofi -dmenu -i -p "<span color='#4fd6e0'>  Settings</span>" -no-custom -markup-rows -theme "$THEME")

case "$choice" in
    *Network*)    kitty --class settings -T "Network" -e nmtui ;;
    *Bluetooth*)  blueman-manager ;;
    *Volume*)     pavucontrol ;;
    *Mic*)        pavucontrol --tab=4 ;;
    *VPN*)        kitty --class settings -T "VPN" -e bash "$HOME/.config/waybar/scripts/vpnc-menu" ;;
    *Brightness*) kitty --class settings -T "Brightness" -e bash -c \
                    'echo "Current: $(brightnessctl g) / $(brightnessctl m)"
                     read -rp "Set % (0-100): " v
                     [[ $v =~ ^[0-9]+$ ]] && brightnessctl s "${v}%"' ;;
    *Battery*)    kitty --class settings -T "Battery" -e bash -c \
                    'upower -i $(upower -e | grep BAT) | grep -E "state|percentage|time"; read' ;;
esac
