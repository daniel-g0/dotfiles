{
	// ─── Groups ──────────────────────────────────────────────────────────────────

	// Minimal bar: desktop number is always visible in the center, hover to reveal all icons.
	"group/main-drawer": {
		"orientation": "vertical",
		"drawer": {
			"transition-duration": 300,
			"transition-left-to-right": false
		},
		"modules": [
			"custom/desktop",
			"temperature", "memory", "cpu", "disk", "clock",
			"bluetooth", "pulseaudio#output", "pulseaudio#input",
			"network", "custom/vpn", "custom/notifications",
			"custom/ganancias", "custom/power"
		]
	},

	// Legacy full layout groups (kept for reference / switching back).
	"group/left": {
		"orientation": "vertical",
		"modules": ["mpris", "temperature", "memory", "cpu", "custom/gpu", "disk", "clock"]
	},

	"group/right": {
		"orientation": "vertical",
		"modules": ["bluetooth", "group/group-volume", "group/laptop", "network", "custom/vpn", "custom/notifications", "custom/ganancias"]
	},

	"group/group-volume": {
		"orientation": "vertical",
		"modules": ["pulseaudio#output", "pulseaudio#input"]
	},

	"group/laptop": {
		"orientation": "vertical",
		"hide-empty-group": true,
		"modules": ["backlight", "battery"]
	},

	// ─── Custom modules ───────────────────────────────────────────────────────────

	"custom/user": {
		"format": "󱄅",
		"min-length": 3,
		"max-length": 3,
		"tooltip-format": "NixOS",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/nix.xml",
		"menu-actions": {
			"nixopts": "kitty --class nix-options -T 'NixOS Options' -e bash ~/.config/waybar/scripts/nix-options",
			"rice":    "kitty --directory $HOME -e env NU_BANNER=1 nu",
			"idler":   "kitty --class idler -T 'Idler' -e bash -c 'cd /home/user/Projects/personal/scripts/idler && nix run . 2>&1; read'"
		}
	},

	"custom/distro": {
		"format": "󱄅",
		"tooltip": false,
		"on-click": "kitty --directory $HOME -e env NU_BANNER=1 nu"
	},

	"custom/notifications": {
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true,
		"format": "{icon}",
		"format-icons": {
			"notification":               "󰂚",
			"none":                        "󰂜",
			"dnd-notification":            "󰂛",
			"dnd-none":                    "󰂛",
			"inhibited-notification":      "󰂚",
			"inhibited-none":              "󰂜",
			"dnd-inhibited-notification":  "󰂛",
			"dnd-inhibited-none":          "󰂛"
		},
		"tooltip": false
	},

	"custom/update": {
		"exec": "~/.config/waybar/scripts/update module",
		"return-type": "json",
		"interval": 3600,
		"signal": 1,
		"format": "{}",
		"min-length": 2,
		"max-length": 2,
		"on-click": "kitty -e ~/.config/waybar/scripts/update",
		"on-click-right": "pkill -RTMIN+1 waybar"
	},

	"custom/power": {
		"format": "󰔛",
		"tooltip-format": "Sleep / Power Menu",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/power.xml",
		"menu-actions": {
			"lock":      "loginctl lock-session",
			"suspend":   "systemctl suspend",
			"hibernate": "systemctl hibernate",
			"reboot":    "systemctl reboot",
			"shutdown":  "systemctl poweroff",
			"logout":    "loginctl terminate-user $USER"
		}
	},

	// ─── System modules ───────────────────────────────────────────────────────────

	"mpris": {
		"format": "{player_icon}",
		"format-paused": "{status_icon}",
		"tooltip-format": "{title} - {artist}\n{album}",
		"player-icons": { "default": "󰐊" },
		"status-icons": { "paused": "󰏤" },
		"max-length": 45
	},

	"temperature": {
		"justify": "center",
		"align": 0.5,
		"critical-threshold": 90,
		"interval": 10,
		"format": "{icon}",
		"format-critical": "<span color='#ff5566'>󰀦</span>",
		"format-icons": ["󱃃", "󰔏", "󱃂"],
		"tooltip-format": "{temperatureC}°C / {temperatureF}°F"
	},

	"memory": {
		"justify": "center",
		"align": 0.5,
		"interval": 10,
		"format": "󰘚",
		"format-warning": "<span color='#e8a04c'>󰀧</span>",
		"format-critical": "<span color='#ff5566'>󰀧</span>",
		"states": { "warning": 75, "critical": 90 },
		"tooltip-format": "{percentage}%  {used:0.1f}/{total:0.1f} GiB"
	},

	"cpu": {
		"justify": "center",
		"align": 0.5,
		"interval": 10,
		"format": "󰍛",
		"format-warning": "<span color='#e8a04c'>󰀨</span>",
		"format-critical": "<span color='#ff5566'>󰀨</span>",
		"states": { "warning": 75, "critical": 90 },
		"tooltip-format": "{usage}%"
	},

	"custom/gpu": {
		"exec-if": "which nvidia-smi",
		"exec": "~/.config/waybar/scripts/gpu",
		"return-type": "json",
		"interval": 5,
		"justify": "center",
		"align": 0.5,
		"format": "󰢮",
		"tooltip": true
	},

	"disk": {
		"justify": "center",
		"align": 0.5,
		"interval": 30,
		"path": "/",
		"format": "󰋊",
		"states": { "warning": 75, "critical": 90 },
		"tooltip-format": "{percentage_used}%  {used} / {total} ({free} free)"
	},

	// Current desktop number only. hyprland/workspaces can't do this: the persistent
	// workspaces from split-monitor-workspaces all show up even with "active-only".
	"custom/desktop": {
		"exec": "~/.config/waybar/scripts/desktop",
		"return-type": "json",
		"format": "{}",
		"tooltip": false,
		"on-click": "bash ~/.config/waybar/scripts/toggle-layout"
	},

	"clock": {
		"justify": "center",
		"align": 0.5,
		"format": "󰥔",
		"tooltip-format": "<big>{:%H:%M  %a %d %b %Y}</big>\n<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 6,
			"format": {
				"months":   "<span color='#c0caf5'><b>{}</b></span>",
				"weekdays": "<span color='#e8a04c'><b>{}</b></span>",
				"days":     "<span color='#a9b1d6'>{}</span>",
				"today":    "<span color='#7dcfff'><b><u>{}</u></b></span>"
			}
		}
	},

	"custom/vpn": {
		"exec": "~/.config/waybar/scripts/vpn",
		"return-type": "json",
		"interval": 5,
		"min-length": 2,
		"max-length": 2,
		"on-click": "kitty --class vpn-menu -T 'VPN Manager' -e ~/.config/waybar/scripts/vpn-menu"
	},

	"custom/eyecare": {
		"exec": "~/.config/waybar/scripts/eyecare",
		"return-type": "json",
		"interval": 1,
		"on-click": "~/.config/waybar/scripts/eyecare reset",
		"tooltip": true
	},

	"custom/ganancias": {
		"exec": "~/.config/waybar/scripts/ganancias",
		"return-type": "json",
		"on-click": "kitty --class ganancias -T 'Ganancias' -e ~/.config/waybar/scripts/ganancias live",
		"tooltip": true
	},

	"network": {
		"interval": 10,
		"format": "󰤨",
		"format-ethernet": "󰈀",
		"format-wifi": "{icon}",
		"format-disconnected": "󰤯",
		"format-disabled": "󰤮",
		"format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
		"tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{signalStrength}%  {frequency} GHz",
		"tooltip-format-ethernet": "{ifname}",
		"tooltip-format-disconnected": "Disconnected",
		"on-click": "nm-connection-editor",
		"on-click-right": "nmcli radio wifi toggle"
	},

	"bluetooth": {
		"format": "󰂯",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"format-on": "󰂰",
		"format-connected": "󰂱",
		"tooltip-format-on": "Bluetooth on",
		"tooltip-format-off": "Bluetooth off",
		"tooltip-format-connected": "{device_alias}",
		"tooltip-format-connected-battery": "{device_alias}  {device_battery_percentage}%",
		"menu": "on-click",
		"menu-file": "~/.config/waybar/menus/bluetooth.xml",
		"menu-actions": {
			"manager": "blueman-manager",
			"bt-on":   "bluetoothctl power on",
			"bt-off":  "bluetoothctl power off"
		}
	},

	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "󰛊",
			"deactivated": "󰒲"
		},
		"tooltip-format-activated": "Idle inhibited",
		"tooltip-format-deactivated": "Idle allowed"
	},

	"pulseaudio#output": {
		"format": "{icon}",
		"format-muted": "󰝟",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"],
			"default-muted": "󰝟",
			"headphone": "󰋋",
			"headphone-muted": "󰟎"
		},
		"on-click": "~/.config/waybar/scripts/volume output mute",
		"on-scroll-up": "~/.config/waybar/scripts/volume output raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume output lower",
		"tooltip-format": "{volume}%  {desc}"
	},

	"pulseaudio#input": {
		"format": "{format_source}",
		"format-source": "󰍬",
		"format-source-muted": "󰍭",
		"on-click": "~/.config/waybar/scripts/volume input mute",
		"on-scroll-up": "~/.config/waybar/scripts/volume input raise",
		"on-scroll-down": "~/.config/waybar/scripts/volume input lower",
		"tooltip-format": "{volume}%  {desc}"
	},

	"backlight": {
		"format": "{icon}",
		"tooltip-format": "{percent}%",
		"format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
		"on-scroll-up": "~/.config/waybar/scripts/backlight up",
		"on-scroll-down": "~/.config/waybar/scripts/backlight down"
	},

	"battery": {
		"bat": "BAT0",
		"adapter": "AC",
		"states": { "warning": 20, "critical": 10 },
		"format": "{icon}",
		"format-charging": "󰉁",
		"format-icons": ["󰂎", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"tooltip-format": "{capacity}%  {time}",
		"tooltip-format-charging": "Charging  {capacity}%  {time}",
		"events": {
			"on-discharging-warning":  "notify-send 'Battery Low (20%)' -u critical",
			"on-discharging-critical": "notify-send 'Battery Critical (10%)' -u critical",
			"on-charging-100":         "notify-send 'Battery Full'"
		}
	}
}
