{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "claude-sonnet-4-6",
  "statusLine": {
    "type": "command",
    "command": "bash \"/home/user/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "context7@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "fuck-you@fuck-you": true,
    "labia@labia": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "fuck-you": {
      "source": {
        "source": "github",
        "repo": "daniel-g0/fuck-you"
      }
    },
    "labia": {
      "source": {
        "source": "github",
        "repo": "daniel-g0/labia"
      }
    }
  },
  "skipWebFetchPreflight": true,
  "feedbackSurveyRate": 0,
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}